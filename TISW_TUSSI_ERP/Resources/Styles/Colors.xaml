<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colores Base -->
    <Color x:Key="AppBackground">#F8FAFC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- Colores de Marca y Acento -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="PrimaryLight">#DBEAFE</Color>
    <Color x:Key="Secondary">#64748B</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#0F172A</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="MidnightBlue">#191970</Color>
    <Color x:Key="Magenta">#D03A82</Color>

    <!-- Escala de grises usada por Styles.xaml -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Brushes requeridos por Styles.xaml -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Colores Semánticos y Alias del ERP -->
    <Color x:Key="SecondaryText">#64748B</Color>
    <Color x:Key="PrimaryText">#0F172A</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>

    <Color x:Key="ErpPrimary">#1D6FD8</Color>
    <Color x:Key="ErpPrimarySoft">#E8F1FD</Color>
    <Color x:Key="ErpPrimaryLight">#DBEAFE</Color>
    <Color x:Key="ErpNavy">#0B2A4A</Color>
    <Color x:Key="ErpBg">#F4F6FA</Color>
    <Color x:Key="ErpBackground">#F8FAFC</Color>
    <Color x:Key="ErpCardBackground">#FFFFFF</Color>
    <Color x:Key="ErpBorder">#E2E8F0</Color>
    <Color x:Key="ErpText">#0F172A</Color>
    <Color x:Key="ErpPrimaryText">#0F172A</Color>
    <Color x:Key="ErpMuted">#64748B</Color>
    <Color x:Key="ErpSecondaryText">#64748B</Color>
    <Color x:Key="ErpSuccess">#16A34A</Color>
    <Color x:Key="ErpWarning">#D97706</Color>
    <Color x:Key="ErpDanger">#DC2626</Color>

    <!-- Colores Semánticos para Badges -->
    <Color x:Key="SuccessBg">#DCFCE7</Color>
    <Color x:Key="SuccessText">#166534</Color>
    <Color x:Key="DangerBg">#FEE2E2</Color>
    <Color x:Key="DangerText">#991B1B</Color>
    <Color x:Key="WarningBg">#FEF3C7</Color>
    <Color x:Key="WarningText">#92400E</Color>
</ResourceDictionary>
