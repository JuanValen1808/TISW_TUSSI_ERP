<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="ErpPrimary">#1D6FD8</Color>
    <Color x:Key="ErpPrimarySoft">#E8F1FD</Color>
    <Color x:Key="ErpPrimaryLight">#DBEAFE</Color>
    <Color x:Key="ErpNavy">#0B2A4A</Color>
    <Color x:Key="ErpBg">#F4F6FA</Color>
    <Color x:Key="ErpBackground">#F8FAFC</Color>
    <Color x:Key="ErpCardBackground">#FFFFFF</Color>
    <Color x:Key="ErpBorder">#E3E8EF</Color>
    <Color x:Key="ErpText">#111827</Color>
    <Color x:Key="ErpPrimaryText">#0F172A</Color>
    <Color x:Key="ErpMuted">#6B7280</Color>
    <Color x:Key="ErpSecondaryText">#64748B</Color>
    <Color x:Key="ErpSuccess">#16A34A</Color>
    <Color x:Key="ErpDanger">#DC2626</Color>
    <Color x:Key="ErpWarning">#F59E0B</Color>

    <!-- Tarjeta contenedora -->
    <Style x:Key="ErpCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="#E2E8F0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#0F172A" Offset="0,4" Radius="12" Opacity="0.04" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource ErpCard}" />

    <!-- Cajas de entrada -->
    <Style x:Key="ErpInputBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#F8FAFC" />
        <Setter Property="Stroke" Value="#E2E8F0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="ErpEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="#0F172A" />
        <Setter Property="PlaceholderColor" Value="#9CA3AF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Tipografía -->
    <Style x:Key="ErpTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#0F172A" />
    </Style>

    <Style x:Key="HeaderTitleStyle" TargetType="Label" BasedOn="{StaticResource ErpTitle}" />

    <Style x:Key="ErpSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#64748B" />
    </Style>

    <Style x:Key="ErpCaption" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>

    <Style x:Key="ErpCardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#111827" />
    </Style>

    <Style x:Key="ErpKpi" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#111827" />
    </Style>

    <Style x:Key="ErpBody" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#111827" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ErpLabel" TargetType="Label">
        <Setter Property="TextColor" Value="#0F172A" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ErpSmallLabel" TargetType="Label">
        <Setter Property="TextColor" Value="#64748B" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ErpSeparator" TargetType="BoxView">
        <Setter Property="Color" Value="#E2E8F0" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- Botones -->
    <Style x:Key="ErpPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2563EB" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ErpSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#F1F5F9" />
        <Setter Property="TextColor" Value="#0F172A" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ErpDangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#FEE2E2" />
        <Setter Property="TextColor" Value="#DC2626" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ErpGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="#111827" />
        <Setter Property="BorderColor" Value="#E3E8EF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="ErpTab" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="#6B7280" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
</ResourceDictionary>
