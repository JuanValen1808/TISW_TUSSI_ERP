<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Estilos exclusivos del módulo de Contabilidad (prefijo "Ctb").
    Archivo separado de ErpStyles.xaml para no generar conflictos con los demás módulos.
    Nota: se usan colores hex directos porque un ResourceDictionary independiente
    no puede resolver StaticResource definidos en otros diccionarios fusionados.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Paleta contable ===== -->
    <Color x:Key="CtbIndigo">#4F46E5</Color>
    <Color x:Key="CtbIndigoSoft">#EEF2FF</Color>
    <Color x:Key="CtbBlue">#1D6FD8</Color>
    <Color x:Key="CtbBlueSoft">#E8F1FD</Color>
    <Color x:Key="CtbTeal">#0D9488</Color>
    <Color x:Key="CtbTealSoft">#CCFBF1</Color>
    <Color x:Key="CtbEmerald">#059669</Color>
    <Color x:Key="CtbEmeraldSoft">#D1FAE5</Color>
    <Color x:Key="CtbRose">#E11D48</Color>
    <Color x:Key="CtbRoseSoft">#FFE4E6</Color>
    <Color x:Key="CtbAmber">#D97706</Color>
    <Color x:Key="CtbAmberSoft">#FEF3C7</Color>
    <Color x:Key="CtbViolet">#7C3AED</Color>
    <Color x:Key="CtbVioletSoft">#EDE9FE</Color>
    <Color x:Key="CtbSlate">#475569</Color>
    <Color x:Key="CtbHead">#F8FAFC</Color>
    <Color x:Key="CtbLine">#EEF2F7</Color>

    <!-- Degradado del encabezado de reportes -->
    <LinearGradientBrush x:Key="CtbHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B2A4A" Offset="0.0" />
        <GradientStop Color="#1D4ED8" Offset="0.65" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Encabezado "hero" de reportes ===== -->
    <Style x:Key="CtbHero" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CtbHeroBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Shadow">
            <Shadow Brush="#1D4ED8" Opacity="0.25" Radius="18" Offset="0,6" />
        </Setter>
    </Style>
    <Style x:Key="CtbHeroEyebrow" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="#A5B4FC" />
    </Style>
    <Style x:Key="CtbHeroTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="CtbHeroSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#DBEAFE" />
    </Style>
    <Style x:Key="CtbHeroChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#26FFFFFF" />
        <Setter Property="Stroke" Value="#40FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="CtbHeroChipText" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="CtbHeroButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="#0B2A4A" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E0E7FF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="CtbHeroGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#1FFFFFFF" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="#59FFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#40FFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Botones de pantalla ===== -->
    <Style x:Key="CtbPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#1D6FD8" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1557B0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="CtbGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="#111827" />
        <Setter Property="BorderColor" Value="#E3E8EF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#F1F5F9" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="CtbTab" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="#475569" />
        <Setter Property="BorderColor" Value="#E3E8EF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- ===== Tarjetas KPI ===== -->
    <Style x:Key="CtbKpiCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="#E3E8EF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="#0F172A" Opacity="0.05" Radius="10" Offset="0,3" />
        </Setter>
    </Style>
    <Style x:Key="CtbKpiAccent" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style x:Key="CtbKpiLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>
    <Style x:Key="CtbKpiValue" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#111827" />
    </Style>
    <Style x:Key="CtbKpiHint" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>

    <!-- ===== Barra de filtros ===== -->
    <Style x:Key="CtbFilterBar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="#E3E8EF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="CtbFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>
    <Style x:Key="CtbField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#F8FAFC" />
        <Setter Property="Stroke" Value="#E3E8EF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <!-- ===== Tablas ===== -->
    <Style x:Key="CtbTable" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="#E3E8EF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="CtbTableHead" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="#F8FAFC" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style x:Key="CtbRow" TargetType="Grid">
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>
    <Style x:Key="CtbTotalRow" TargetType="Grid">
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="#F1F5F9" />
    </Style>
    <Style x:Key="CtbTh" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="#64748B" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="CtbThRight" TargetType="Label" BasedOn="{StaticResource CtbTh}">
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="CtbTd" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#111827" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="CtbTdStrong" TargetType="Label" BasedOn="{StaticResource CtbTd}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="CtbTdMuted" TargetType="Label" BasedOn="{StaticResource CtbTd}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>
    <Style x:Key="CtbMoney" TargetType="Label" BasedOn="{StaticResource CtbTd}">
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="CtbMoneyStrong" TargetType="Label" BasedOn="{StaticResource CtbMoney}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="CtbDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="#EEF2F7" />
        <Setter Property="BackgroundColor" Value="#EEF2F7" />
    </Style>

    <!-- ===== Pills / etiquetas ===== -->
    <Style x:Key="CtbPill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="CtbPillText" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.3" />
    </Style>

    <!-- ===== Textos ===== -->
    <Style x:Key="CtbPageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#111827" />
    </Style>
    <Style x:Key="CtbPageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#6B7280" />
    </Style>
    <Style x:Key="CtbSectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#111827" />
    </Style>
    <Style x:Key="CtbEmpty" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="#94A3B8" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,28" />
    </Style>

    <!-- ===== Banners de estado ===== -->
    <Style x:Key="CtbErrorBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FEF2F2" />
        <Setter Property="Stroke" Value="#FECACA" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="CtbOkBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#ECFDF5" />
        <Setter Property="Stroke" Value="#A7F3D0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="CtbProgress" TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>
