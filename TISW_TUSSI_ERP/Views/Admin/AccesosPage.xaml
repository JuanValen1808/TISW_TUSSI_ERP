<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Seguridad"
             xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Seguridad"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Admin.AccesosPage"
             x:DataType="vm:AccesosViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ErpBg}"
             Title="Accesos">

    <Grid RowDefinitions="Auto,*">
        <!-- Encabezado de página -->
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Administración" Titulo="Mantenedor de Accesos y Permisos" />

        <Grid Grid.Row="1">
            <Grid ColumnDefinitions="300,*" Padding="24" ColumnSpacing="20">

                <!-- COLUMNA IZQUIERDA: Selector de Perfiles -->
                <Border Grid.Column="0" Style="{StaticResource ErpCard}" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                        <Label Grid.Row="0" Text="PERFILES DEL SISTEMA" Style="{StaticResource ErpCaption}" />
                        <Label Grid.Row="1" Text="Selecciona un perfil para configurar sus permisos de acceso:"
                               FontSize="12" TextColor="{StaticResource ErpMuted}" />

                        <!-- Listado de perfiles seleccionables -->
                        <ScrollView Grid.Row="2">
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Roles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:RolModel">
                                        <Border StrokeThickness="{Binding GrosorBordeSeleccionado}"
                                                Stroke="{Binding BordeSeleccionado}"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="12,10"
                                                BackgroundColor="{Binding FondoSeleccionado}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccesosViewModel}}, Path=ComandoSeleccionarRol}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding NombreRol}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource ErpText}" />
                                                    <Label Text="{Binding PermisosTexto}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource ErpMuted}" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        WidthRequest="10"
                                                        HeightRequest="10"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 5"
                                                        BackgroundColor="{StaticResource ErpPrimary}"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>

                        <Button Grid.Row="3"
                                Text="+ Nuevo Permiso en Catálogo"
                                Style="{StaticResource ErpGhostButton}"
                                Command="{Binding ComandoAbrirNuevoPermiso}" />
                    </Grid>
                </Border>

                <!-- COLUMNA DERECHA: Matriz de Permisos por Módulo -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">

                    <!-- Barra superior de acciones para el rol seleccionado -->
                    <Border Grid.Row="0" Style="{StaticResource ErpCard}" Padding="16,14" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding NombreRolSeleccionadoTexto}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource ErpText}" />
                                <Label Text="{Binding ResumenPermisosTexto}"
                                       FontSize="12"
                                       TextColor="{StaticResource ErpMuted}" />
                            </VerticalStackLayout>

                            <!-- Indicador de cambios sin guardar -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HayCambiosPendientes}"
                                    BackgroundColor="#FEF3C7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="Cambios sin guardar"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#B45309" />
                            </Border>

                            <!-- Botón Guardar Cambios -->
                            <Button Grid.Column="2"
                                    Text="Guardar Cambios"
                                    Style="{StaticResource ErpPrimaryButton}"
                                    Command="{Binding ComandoGuardarAccesos}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Lista con módulos y permisos -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="16">

                            <!-- Banner de notificación -->
                            <Border IsVisible="{Binding HayMensajeGeneral}"
                                    BackgroundColor="{Binding FondoMensajeGeneral}"
                                    Stroke="{Binding ColorMensajeGeneral}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="14,10">
                                <Label Text="{Binding MensajeGeneral}"
                                       TextColor="{Binding ColorMensajeGeneral}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>

                            <!-- Indicador de carga -->
                            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                               IsVisible="{Binding EstaOcupado}"
                                               Color="{StaticResource ErpPrimary}"
                                               Margin="0,10" />

                            <!-- Grupos de Módulos -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding GruposModulos}" Spacing="14">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:ModuloPermisosGrupo">
                                        <Border Style="{StaticResource ErpCard}" Padding="0">
                                            <VerticalStackLayout>

                                                <!-- Cabecera del Módulo -->
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                      BackgroundColor="#F8FAFC"
                                                      Padding="16,10"
                                                      ColumnSpacing="8">
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="{Binding NombreModulo, StringFormat='MÓDULO: {0}'}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource ErpNavy}" />
                                                        <Label Text="{Binding ResumenHabilitados}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource ErpMuted}" />
                                                    </VerticalStackLayout>

                                                    <!-- Botón Marcar Todos -->
                                                    <Button Grid.Column="2"
                                                            Text="Habilitar todos"
                                                            Style="{StaticResource ErpGhostButton}"
                                                            HeightRequest="28"
                                                            FontSize="10"
                                                            Padding="8,0"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccesosViewModel}}, Path=ComandoSeleccionarTodosModulo}"
                                                            CommandParameter="{Binding .}" />

                                                    <!-- Botón Desmarcar Todos -->
                                                    <Button Grid.Column="3"
                                                            Text="Desmarcar todos"
                                                            Style="{StaticResource ErpGhostButton}"
                                                            HeightRequest="28"
                                                            FontSize="10"
                                                            Padding="8,0"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccesosViewModel}}, Path=ComandoDesmarcarTodosModulo}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                                <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                                                <!-- Lista de permisos individuales del módulo -->
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Permisos}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="m:PermisoModel">
                                                            <VerticalStackLayout>
                                                                <Grid ColumnDefinitions="2*,4*,Auto"
                                                                      Padding="16,12"
                                                                      ColumnSpacing="12">

                                                                    <!-- Código de Permiso -->
                                                                    <Border BackgroundColor="#F1F5F9"
                                                                            StrokeThickness="0"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            Padding="8,4"
                                                                            HorizontalOptions="Start"
                                                                            VerticalOptions="Center">
                                                                        <Label Text="{Binding CodigoPermiso}"
                                                                               FontSize="11"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{StaticResource ErpNavy}" />
                                                                    </Border>

                                                                    <!-- Descripción -->
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding Descripcion}"
                                                                           Style="{StaticResource ErpBody}"
                                                                           FontSize="12"
                                                                           VerticalOptions="Center" />

                                                                    <!-- Switch Interactivo -->
                                                                    <HorizontalStackLayout Grid.Column="2"
                                                                                           Spacing="8"
                                                                                           VerticalOptions="Center">
                                                                        <Label Text="{Binding EstadoTexto}"
                                                                               FontSize="11"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{Binding EstadoColor}"
                                                                               VerticalOptions="Center" />
                                                                        <Switch IsToggled="{Binding Asignado, Mode=TwoWay}"
                                                                                ThumbColor="{StaticResource ErpPrimary}"
                                                                                OnColor="{StaticResource ErpPrimarySoft}"
                                                                                VerticalOptions="Center" />
                                                                    </HorizontalStackLayout>
                                                                </Grid>
                                                                <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>

            <!-- MODAL PARA CREAR NUEVO PERMISO EN CATÁLOGO -->
            <Grid IsVisible="{Binding MostrarModalNuevoPermiso}"
                  BackgroundColor="#66000000"
                  Padding="20">

                <Border Style="{StaticResource ErpCard}"
                        WidthRequest="500"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="24"
                        Shadow="{Shadow Brush=Black, Offset='0,10', Radius=20, Opacity=0.25}">

                    <VerticalStackLayout Spacing="14">

                        <!-- Encabezado Modal -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Nuevo Permiso en Catálogo"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource ErpText}" />
                                <Label Text="Agrega una nueva capacidad operativa al sistema ERP."
                                       FontSize="12"
                                       TextColor="{StaticResource ErpMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Cerrar"
                                    Style="{StaticResource ErpGhostButton}"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Command="{Binding ComandoCerrarNuevoPermiso}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Formulario -->
                        <VerticalStackLayout Spacing="12">

                            <!-- Código de Permiso -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Código del Permiso *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                <Border Style="{StaticResource ErpInputBox}">
                                    <Entry Style="{StaticResource ErpEntry}"
                                           Placeholder="Ej: CLIENTES_DESCUENTO_ESPECIAL"
                                           Text="{Binding NuevoCodigoPermiso}" />
                                </Border>
                                <Label Text="{Binding ErrorNuevoCodigo}"
                                       TextColor="{StaticResource ErpDanger}"
                                       FontSize="11"
                                       IsVisible="{Binding HayErrorNuevoCodigo}" />
                            </VerticalStackLayout>

                            <!-- Módulo -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Módulo del ERP *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                <Border Style="{StaticResource ErpInputBox}">
                                    <Picker Title="Seleccionar módulo"
                                            ItemsSource="{Binding ModulosDisponibles}"
                                            SelectedItem="{Binding NuevoModulo}"
                                            TextColor="{StaticResource ErpText}"
                                            FontSize="13" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Descripción -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Descripción de la Acción *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                <Border Style="{StaticResource ErpInputBox}">
                                    <Entry Style="{StaticResource ErpEntry}"
                                           Placeholder="Describe lo que autoriza este permiso..."
                                           Text="{Binding NuevaDescripcion}" />
                                </Border>
                                <Label Text="{Binding ErrorNuevaDescripcion}"
                                       TextColor="{StaticResource ErpDanger}"
                                       FontSize="11"
                                       IsVisible="{Binding HayErrorNuevaDescripcion}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Acciones -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Cancelar"
                                    Style="{StaticResource ErpGhostButton}"
                                    Command="{Binding ComandoCerrarNuevoPermiso}" />
                            <Button Grid.Column="1"
                                    Text="Guardar Permiso"
                                    Style="{StaticResource ErpPrimaryButton}"
                                    Command="{Binding ComandoGuardarNuevoPermiso}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
