<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Seguridad"
             xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Seguridad"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Admin.PerfilesPage"
             x:DataType="vm:PerfilesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ErpBg}"
             Title="Perfiles">

    <Grid RowDefinitions="Auto,*">
        <!-- Encabezado de página -->
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Administración" Titulo="Mantenedor de Perfiles" />

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="24" Spacing="16">

                    <!-- Banner de notificación -->
                    <Border IsVisible="{Binding HayMensajeGeneral}"
                            BackgroundColor="{Binding FondoMensajeGeneral}"
                            Stroke="{Binding ColorMensajeGeneral}"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,10">
                        <Label Text="{Binding MensajeGeneral}"
                               TextColor="{Binding ColorMensajeGeneral}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Barra superior -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource ErpInputBox}">
                            <Entry Style="{StaticResource ErpEntry}"
                                   Placeholder="Buscar perfil por nombre o descripción..."
                                   Text="{Binding TextoBusqueda}" />
                        </Border>

                        <Button Grid.Column="1"
                                Text="+ Nuevo Perfil"
                                Style="{StaticResource ErpPrimaryButton}"
                                Command="{Binding ComandoNuevo}" />
                    </Grid>

                    <!-- Tarjeta con lista de perfiles -->
                    <Border Style="{StaticResource ErpCard}" Padding="0">
                        <ScrollView Orientation="Horizontal">
                            <VerticalStackLayout MinimumWidthRequest="940">

                                <!-- Encabezado de tabla -->
                                <Grid ColumnDefinitions="60,340,140,140,260"
                                      BackgroundColor="#F8FAFC"
                                      Padding="16,12"
                                      ColumnSpacing="10">
                                    <Label Text="ID" Style="{StaticResource ErpCaption}" />
                                    <Label Grid.Column="1" Text="NOMBRE Y DESCRIPCIÓN DEL PERFIL" Style="{StaticResource ErpCaption}" />
                                    <Label Grid.Column="2" Text="USUARIOS" Style="{StaticResource ErpCaption}" />
                                    <Label Grid.Column="3" Text="PERMISOS" Style="{StaticResource ErpCaption}" />
                                    <Label Grid.Column="4" Text="ACCIONES" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="End" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                                <!-- Indicador de carga -->
                                <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                                   IsVisible="{Binding EstaOcupado}"
                                                   Color="{StaticResource ErpPrimary}"
                                                   Margin="0,16" />

                                <!-- Listado de perfiles -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Roles}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:RolModel">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="60,340,140,140,260"
                                                      Padding="16,14"
                                                      ColumnSpacing="10">

                                                    <!-- ID -->
                                                    <Label Text="{Binding IdRol}"
                                                           Style="{StaticResource ErpBody}"
                                                           TextColor="{StaticResource ErpMuted}"
                                                           VerticalOptions="Center" />

                                                    <!-- Nombre y Descripción -->
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding NombreRol}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource ErpText}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1" />
                                                        <Label Text="{Binding Descripcion}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource ErpMuted}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="2" />
                                                    </VerticalStackLayout>

                                                    <!-- Conteo de Usuarios -->
                                                    <Border Grid.Column="2"
                                                            BackgroundColor="#F1F5F9"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="10,5"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding UsuariosTexto}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource ErpNavy}"
                                                               LineBreakMode="NoWrap" />
                                                    </Border>

                                                    <!-- Conteo de Permisos -->
                                                    <Border Grid.Column="3"
                                                            BackgroundColor="{StaticResource ErpPrimarySoft}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="10,5"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding PermisosTexto}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource ErpPrimary}"
                                                               LineBreakMode="NoWrap" />
                                                    </Border>

                                                    <!-- Acciones -->
                                                    <HorizontalStackLayout Grid.Column="4"
                                                                           Spacing="6"
                                                                           HorizontalOptions="End"
                                                                           VerticalOptions="Center">

                                                        <!-- Botón Gestionar Accesos -->
                                                        <Button Text="Gestionar Accesos"
                                                                Style="{StaticResource ErpGhostButton}"
                                                                HeightRequest="32"
                                                                FontSize="11"
                                                                Padding="8,0"
                                                                TextColor="{StaticResource ErpPrimary}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PerfilesViewModel}}, Path=ComandoGestionarAccesos}"
                                                                CommandParameter="{Binding .}" />

                                                        <!-- Botón Editar -->
                                                        <Button Text="Editar"
                                                                Style="{StaticResource ErpGhostButton}"
                                                                HeightRequest="32"
                                                                FontSize="11"
                                                                Padding="8,0"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PerfilesViewModel}}, Path=ComandoEditar}"
                                                                CommandParameter="{Binding .}" />

                                                        <!-- Botón Eliminar -->
                                                        <Button Text="Eliminar"
                                                                TextColor="{StaticResource ErpDanger}"
                                                                BorderColor="#FECACA"
                                                                BackgroundColor="#FEF2F2"
                                                                HeightRequest="32"
                                                                FontSize="11"
                                                                CornerRadius="8"
                                                                Padding="8,0"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PerfilesViewModel}}, Path=ComandoEliminar}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                                <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Mensaje si no hay perfiles -->
                                <VerticalStackLayout IsVisible="{Binding NoHayRoles}"
                                                     Padding="30"
                                                     Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Label Text="No se encontraron perfiles"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource ErpMuted}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Registra un nuevo perfil para definir los roles de trabajo."
                                           FontSize="12"
                                           TextColor="{StaticResource ErpMuted}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- MODAL DE CREACIÓN / EDICIÓN -->
            <Grid IsVisible="{Binding MostrarFormulario}"
                  BackgroundColor="#66000000"
                  Padding="20">

                <Border Style="{StaticResource ErpCard}"
                        WidthRequest="500"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="24"
                        Shadow="{Shadow Brush=Black, Offset='0,10', Radius=20, Opacity=0.25}">

                    <VerticalStackLayout Spacing="14">

                        <!-- Encabezado Modal -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TituloFormulario}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource ErpText}" />
                                <Label Text="Define el nombre y las funciones del perfil de usuario."
                                       FontSize="12"
                                       TextColor="{StaticResource ErpMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Cerrar"
                                    Style="{StaticResource ErpGhostButton}"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Command="{Binding ComandoCancelar}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Formulario -->
                        <VerticalStackLayout Spacing="12">

                            <!-- Nombre del Perfil -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nombre del Perfil *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                <Border Style="{StaticResource ErpInputBox}">
                                    <Entry Style="{StaticResource ErpEntry}"
                                           Placeholder="Ej: Supervisor de Ventas, Farmacéutico..."
                                           Text="{Binding FormNombreRol}" />
                                </Border>
                                <Label Text="{Binding ErrorNombre}"
                                       TextColor="{StaticResource ErpDanger}"
                                       FontSize="11"
                                       IsVisible="{Binding HayErrorNombre}" />
                            </VerticalStackLayout>

                            <!-- Descripción -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Descripción y Alcance *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                <Border Style="{StaticResource ErpInputBox}" HeightRequest="80" Padding="12,8">
                                    <Editor AutoSize="Disabled"
                                            Placeholder="Describe las atribuciones o responsabilidades de este perfil en el ERP..."
                                            Text="{Binding FormDescripcion}"
                                            TextColor="{StaticResource ErpText}"
                                            FontSize="13"
                                            BackgroundColor="Transparent" />
                                </Border>
                                <Label Text="{Binding ErrorDescripcion}"
                                       TextColor="{StaticResource ErpDanger}"
                                       FontSize="11"
                                       IsVisible="{Binding HayErrorDescripcion}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Acciones -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Cancelar"
                                    Style="{StaticResource ErpGhostButton}"
                                    Command="{Binding ComandoCancelar}" />
                            <Button Grid.Column="1"
                                    Text="{Binding TextoBotonGuardar}"
                                    Style="{StaticResource ErpPrimaryButton}"
                                    Command="{Binding ComandoGuardar}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
