<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Compras"
             xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Compras"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Compras.ReporteComprasPage"
             x:DataType="vm:ReporteComprasViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ErpBg}"
             Title="Reporte de Compras">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Compras › Reportes" Titulo="Registro de Compras por Laboratorio" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">

                <Border IsVisible="{Binding HayError}" BackgroundColor="#FEE2E2" Stroke="#FCA5A5" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding MensajeError}" TextColor="#B91C1C" FontSize="12" />
                </Border>

                <!-- Título y descripción -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Registro Consolidado de Compras por Laboratorio" Style="{StaticResource ErpTitle}" />
                        <Label Text="Consolidado de facturas y adquisiciones filtrado por rango de fechas y RUT del proveedor."
                               Style="{StaticResource ErpSubtitle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Exportar CSV" Style="{StaticResource ErpGhostButton}"
                            Command="{Binding ComandoExportarCsv}" IsEnabled="{Binding NoEstaOcupado}" VerticalOptions="Center" />
                </Grid>

                <!-- Filtros de Búsqueda -->
                <Border Style="{StaticResource ErpCard}" Padding="16">
                    <Grid ColumnDefinitions="150, 150, 250, *, Auto" ColumnSpacing="14" VerticalOptions="Center">

                        <!-- Fecha Desde -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Desde" Style="{StaticResource ErpCaption}" />
                            <Border Style="{StaticResource ErpInputBox}">
                                <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy" VerticalOptions="Center" TextColor="{StaticResource ErpText}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fecha Hasta -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Hasta" Style="{StaticResource ErpCaption}" />
                            <Border Style="{StaticResource ErpInputBox}">
                                <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy" VerticalOptions="Center" TextColor="{StaticResource ErpText}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Buscador por RUT -->
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="RUT proveedor (opcional)" Style="{StaticResource ErpCaption}" />
                            <Border Style="{StaticResource ErpInputBox}">
                                <Entry Text="{Binding RutFiltro}" Placeholder="Ej: 76.555.444-3" Style="{StaticResource ErpEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Botones -->
                        <HorizontalStackLayout Grid.Column="4" Spacing="10" VerticalOptions="End">
                            <Button Text="Limpiar" Command="{Binding ComandoLimpiarFiltro}" IsEnabled="{Binding NoEstaOcupado}" Style="{StaticResource ErpGhostButton}" HeightRequest="46"/>
                            <Button Text="Generar Reporte" Command="{Binding ComandoGenerar}" IsEnabled="{Binding NoEstaOcupado}" Style="{StaticResource ErpPrimaryButton}" HeightRequest="46"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" Color="{StaticResource ErpPrimary}" />

                <!-- KPIs del período -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="PROVEEDORES CON COMPRAS" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.ProveedoresConCompras}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ÓRDENES EN EL PERÍODO" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.TotalOrdenes}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MONTO TOTAL COMPRADO" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.MontoTotalPeriodoTexto}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MONTO POR RECIBIR" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.MontoPorRecibirTexto}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tabla del reporte -->
                <Border Style="{StaticResource ErpCard}" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="No hay compras registradas para el período y filtro seleccionados."
                               IsVisible="{Binding SinResultados}" Style="{StaticResource ErpSubtitle}"
                               HorizontalOptions="Center" Margin="0,16" />

                        <Grid ColumnDefinitions="2.2*,1*,1.3*,1.3*,1.3*,1.4*" Padding="12,8" BackgroundColor="{StaticResource ErpPrimarySoft}">
                            <Label Text="PROVEEDOR / LABORATORIO" Style="{StaticResource ErpCaption}" TextColor="{StaticResource ErpPrimary}" />
                            <Label Grid.Column="1" Text="ÓRDENES" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="Center" TextColor="{StaticResource ErpPrimary}" />
                            <Label Grid.Column="2" Text="MONTO TOTAL" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="End" TextColor="{StaticResource ErpPrimary}" />
                            <Label Grid.Column="3" Text="POR RECIBIR" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="End" TextColor="{StaticResource ErpPrimary}" />
                            <Label Grid.Column="4" Text="ÚLTIMA COMPRA" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="Center" TextColor="{StaticResource ErpPrimary}" />
                            <Label Grid.Column="5" Text="CUMPLIMIENTO" Style="{StaticResource ErpCaption}" HorizontalTextAlignment="End" TextColor="{StaticResource ErpPrimary}" />
                        </Grid>

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:CompraPorProveedor">
                                    <Border BackgroundColor="#F8FAFC" Stroke="{StaticResource ErpBorder}" StrokeShape="RoundRectangle 8" Padding="12,10">
                                        <Grid ColumnDefinitions="2.2*,1*,1.3*,1.3*,1.3*,1.4*">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Proveedor}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                                <Label Text="{Binding Rut, StringFormat='RUT {0}'}" FontSize="10" TextColor="{StaticResource ErpMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding NumeroOrdenes}" Style="{StaticResource ErpBody}" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="2" Text="{Binding MontoTotalTexto}" Style="{StaticResource ErpBody}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="3" Text="{Binding MontoPorRecibirTexto}" Style="{StaticResource ErpBody}" TextColor="{StaticResource ErpWarning}" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="4" Text="{Binding UltimaCompraTexto}" FontSize="12" TextColor="{StaticResource ErpMuted}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="5" HorizontalOptions="End" Spacing="3">
                                                <Label Text="{Binding CumplimientoTexto}" FontSize="11" FontAttributes="Bold" TextColor="{Binding CumplimientoColor}" HorizontalTextAlignment="End" />
                                                <ProgressBar Progress="{Binding Cumplimiento}" ProgressColor="{Binding CumplimientoColor}" WidthRequest="110" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
