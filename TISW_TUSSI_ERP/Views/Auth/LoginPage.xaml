<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Auth"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="TISW_TUSSI_ERP.Views.Auth.LoginPage"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <Label Text="TUSSI ERP"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Ingresa tus credenciales"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Correo electrónico"
                   Keyboard="Email"
                   Text="{Binding Email}" />

            <Entry Placeholder="Contraseña"
                   IsPassword="True"
                   Text="{Binding Contrasena}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="Red"
                   HorizontalOptions="Center" />

            <Button Text="Iniciar sesión"
                    Command="{Binding ComandoIniciarSesion}" />

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
