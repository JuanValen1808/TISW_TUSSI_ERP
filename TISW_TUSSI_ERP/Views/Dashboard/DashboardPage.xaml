<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Dashboard"
             xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Dashboard"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ErpBg}"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Principal" Titulo="Dashboard" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">

                <Border IsVisible="{Binding HayError}" BackgroundColor="#FEE2E2" Stroke="#FCA5A5" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding MensajeError}" TextColor="#B91C1C" FontSize="12" />
                </Border>

                <!-- Título -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Resumen gerencial" Style="{StaticResource ErpTitle}" />
                        <Label Text="{Binding FechaTexto}" Style="{StaticResource ErpSubtitle}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" Color="{StaticResource ErpPrimary}" />
                        <Button Text="↻  Actualizar" Style="{StaticResource ErpPrimaryButton}" HeightRequest="38"
                                Command="{Binding ComandoActualizar}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- KPIs -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="INGRESOS DEL DÍA" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.IngresosHoyTexto}" Style="{StaticResource ErpKpi}" />
                            <Label Text="{Binding Resumen.VariacionTexto}" TextColor="{Binding Resumen.VariacionColor}" FontSize="12" FontAttributes="Bold" />
                            <Label Text="{Binding Resumen.IngresosAyerTexto}" FontSize="11" TextColor="{StaticResource ErpMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="DOCUMENTOS EMITIDOS HOY" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.DocumentosHoy}" Style="{StaticResource ErpKpi}" />
                            <Label Text="{Binding Resumen.TicketPromedioTexto}" FontSize="11" TextColor="{StaticResource ErpMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ALERTAS DE STOCK MÍNIMO" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.ProductosBajoMinimo}" Style="{StaticResource ErpKpi}" />
                            <Label Text="{Binding Resumen.StockCriticoTexto}" TextColor="{StaticResource ErpDanger}" FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="FACTURAS POR COBRAR" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Resumen.PorCobrarTexto}" Style="{StaticResource ErpKpi}" />
                            <Label Text="{Binding Resumen.PorCobrarDetalle}" FontSize="11" TextColor="{StaticResource ErpMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Gráficos -->
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Ventas de la semana" Style="{StaticResource ErpCardTitle}" />
                            <Label Text="{Binding TotalSemanaTexto}" Style="{StaticResource ErpSubtitle}" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Barras}" Direction="Row"
                                        JustifyContent="SpaceAround" AlignItems="End" HeightRequest="240" Margin="0,8,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:BarraVenta">
                                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Label Text="{Binding MontoCorto}" FontSize="10" TextColor="{StaticResource ErpMuted}" HorizontalTextAlignment="Center" />
                                            <BoxView WidthRequest="42" HeightRequest="{Binding Altura}" Color="{Binding ColorBarra}" CornerRadius="6,6,0,0" />
                                            <Label Text="{Binding Etiqueta}" FontSize="11" TextColor="{StaticResource ErpMuted}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource ErpCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Medios de pago" Style="{StaticResource ErpCardTitle}" />
                                <Label Text="Distribución del día" Style="{StaticResource ErpSubtitle}" />
                                <Grid ColumnDefinitions="140,*" ColumnSpacing="8">
                                    <GraphicsView x:Name="Donut" WidthRequest="130" HeightRequest="130" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"
                                                         BindableLayout.ItemsSource="{Binding MediosPago}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="m:MedioPago">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding Color}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource ErpBody}" FontSize="12" />
                                                    <Label Grid.Column="2" Text="{Binding PorcentajeTexto}" Style="{StaticResource ErpBody}" FontSize="12" FontAttributes="Bold" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource ErpCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Productos más vendidos" Style="{StaticResource ErpCardTitle}" />
                                <Label Text="Últimos 7 días, por unidades" Style="{StaticResource ErpSubtitle}" />
                                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding TopProductos}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:ProductoVendido">
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border WidthRequest="20" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="#EEF2F7">
                                                        <Label Text="{Binding Posicion}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource ErpMuted}"
                                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource ErpBody}" FontSize="12" />
                                                    <Label Grid.Column="2" Text="{Binding UnidadesTexto}" Style="{StaticResource ErpBody}" FontSize="12" FontAttributes="Bold" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding Progreso}" ProgressColor="{StaticResource ErpPrimary}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Stock crítico + Caja -->
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Alertas de stock crítico" Style="{StaticResource ErpCardTitle}" />
                            <Label Text="Productos bajo el mínimo y control de vencimientos" Style="{StaticResource ErpSubtitle}" />

                            <Grid ColumnDefinitions="2.2*,1.2*,1.1*,1.5*" Margin="0,6,0,0">
                                <Label Text="PRODUCTO" Style="{StaticResource ErpCaption}" />
                                <Label Grid.Column="1" Text="STOCK / MÍN." Style="{StaticResource ErpCaption}" />
                                <Label Grid.Column="2" Text="LOTE" Style="{StaticResource ErpCaption}" />
                                <Label Grid.Column="3" Text="VENCIMIENTO" Style="{StaticResource ErpCaption}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Alertas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:AlertaStock">
                                        <Grid ColumnDefinitions="2.2*,1.2*,1.1*,1.5*">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Nombre}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                                <Label Text="{Binding SkuTexto}" FontSize="10" TextColor="{StaticResource ErpMuted}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding StockTexto}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                                                <ProgressBar Progress="{Binding Proporcion}" ProgressColor="{Binding ColorStock}" WidthRequest="70" HorizontalOptions="Start" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Lote}" Style="{StaticResource ErpBody}" FontSize="12" TextColor="{StaticResource ErpMuted}" />
                                            <Border Grid.Column="3" BackgroundColor="{Binding VenceFondo}" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                                    Padding="8,4" HorizontalOptions="Start" VerticalOptions="Center">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding VencimientoTexto}" FontSize="11" FontAttributes="Bold" TextColor="{Binding VenceColor}" />
                                                    <Label Text="{Binding DiasTexto}" FontSize="9" TextColor="{Binding VenceColor}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Estado de caja" Style="{StaticResource ErpCardTitle}" />
                            <Label Text="Movimiento del día" Style="{StaticResource ErpSubtitle}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Efectivo" Style="{StaticResource ErpBody}" />
                                <Label Grid.Column="1" Text="{Binding Resumen.EfectivoTexto}" Style="{StaticResource ErpBody}" TextColor="{StaticResource ErpSuccess}" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Otros medios de pago" Style="{StaticResource ErpBody}" />
                                <Label Grid.Column="1" Text="{Binding Resumen.OtrosMediosTexto}" Style="{StaticResource ErpBody}" FontAttributes="Bold" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total ingresos" Style="{StaticResource ErpBody}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Resumen.IngresosHoyTexto}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource ErpText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Documentos emitidos" Style="{StaticResource ErpBody}" />
                                <Label Grid.Column="1" Text="{Binding Resumen.DocumentosHoy}" Style="{StaticResource ErpBody}" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
