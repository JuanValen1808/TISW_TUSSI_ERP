<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.PlanCuentasPage"
             x:DataType="viewmodels:PlanCuentasViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- HEADER MODERNO -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <VerticalStackLayout>
                <Label Text="Plan de Cuentas" Style="{StaticResource ErpTitle}" />
                <Label Text="Catálogo oficial de cuentas contables." Style="{StaticResource ErpSubtitle}" Margin="0,0,0,10" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Actualizar Catálogo" Command="{Binding CargarCuentasCommand}" Style="{StaticResource ErpSecondaryButton}" VerticalOptions="Center" />
        </Grid>

        <!-- DATA GRID DE CUENTAS -->
        <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="0">
            <RefreshView Command="{Binding CargarCuentasCommand}" IsRefreshing="{Binding EstaOcupado}">
                <VerticalStackLayout>

                    <!-- Cabecera -->
                    <Grid ColumnDefinitions="150, *, 150" Padding="20,12" BackgroundColor="#F1F5F9">
                        <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="NOMBRE DE LA CUENTA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="TIPO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                    <!-- Filas del Catálogo -->
                    <CollectionView ItemsSource="{Binding Cuentas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlanCuentas">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="150, *, 150" Padding="20,12">
                                        <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" />

                                        <!-- Aplicamos negrita si es una cuenta de Nivel 1 o 2 para simular jerarquía -->
                                        <Label Grid.Column="1" Text="{Binding NombreCuenta}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Nivel}" Value="1">
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                    <Setter Property="TextColor" Value="{StaticResource ErpPrimaryText}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Nivel}" Value="2">
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                    <Setter Property="TextColor" Value="{StaticResource ErpPrimaryText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Column="2" Text="{Binding TipoCuenta}" Style="{StaticResource ErpSmallLabel}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" Opacity="0.4" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </RefreshView>
        </Border>

    </Grid>
</ContentPage>