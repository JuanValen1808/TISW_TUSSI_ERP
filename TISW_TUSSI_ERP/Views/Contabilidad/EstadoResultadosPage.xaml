<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.EstadoResultadosPage"
             x:DataType="viewmodels:EstadoResultadosViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*">

        <StackLayout Grid.Row="0" Padding="20">
            <Label Text="Estado de Resultados" Style="{StaticResource ErpTitle}" />
            <Label Text="Reporte operacional de ingresos y gastos." Style="{StaticResource ErpSubtitle}" />
            <Button Text="Generar Reporte" Command="{Binding CargarEstadoResultadosCommand}" Style="{StaticResource ErpPrimaryButton}" HorizontalOptions="Start" />
        </StackLayout>

        <RefreshView Grid.Row="1" Command="{Binding CargarEstadoResultadosCommand}" IsRefreshing="{Binding EstaOcupado}">
            <ScrollView>
                <VerticalStackLayout Margin="20,0,20,30" Spacing="20">

                    <!-- TARJETA: INGRESOS -->
                    <Border Style="{StaticResource ErpCard}">
                        <VerticalStackLayout>
                            <Label Text="INGRESOS OPERACIONALES" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpSuccess}" Margin="0,0,0,10" />

                            <Grid ColumnDefinitions="100, *, 150" Padding="5,10">
                                <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="CUENTA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="MONTO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Ingresos}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                        <Grid ColumnDefinitions="100, *, 150" Padding="5,12">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource ErpLabel}" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource ErpLabel}" />
                                            <Label Grid.Column="2" Text="{Binding Ganancia, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView Style="{StaticResource ErpSeparator}" />

                            <Grid ColumnDefinitions="*, 150">
                                <Label Grid.Column="0" Text="TOTAL INGRESOS:" Style="{StaticResource ErpSmallLabel}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalIngresos, StringFormat='{}{0:C0}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpSuccess}" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- TARJETA: GASTOS -->
                    <Border Style="{StaticResource ErpCard}">
                        <VerticalStackLayout>
                            <Label Text="COSTOS Y GASTOS" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpDanger}" Margin="0,0,0,10" />

                            <Grid ColumnDefinitions="100, *, 150" Padding="5,10">
                                <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="CUENTA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="MONTO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Gastos}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                        <Grid ColumnDefinitions="100, *, 150" Padding="5,12">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource ErpLabel}" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource ErpLabel}" />
                                            <Label Grid.Column="2" Text="{Binding Perdida, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView Style="{StaticResource ErpSeparator}" />

                            <Grid ColumnDefinitions="*, 150">
                                <Label Grid.Column="0" Text="TOTAL GASTOS:" Style="{StaticResource ErpSmallLabel}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalGastos, StringFormat='{}{0:C0}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpDanger}" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- TARJETA: RESULTADO FINAL -->
                    <Border Style="{StaticResource ErpCard}" BackgroundColor="{StaticResource ErpPrimaryText}">
                        <Grid ColumnDefinitions="*, 250" Padding="10">
                            <Label Grid.Column="0" Text="{Binding TextoResultado}" FontAttributes="Bold" FontSize="18" TextColor="White" VerticalOptions="Center" HorizontalTextAlignment="End" />
                            <Label Grid.Column="1" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:C0}'}" FontAttributes="Bold" FontSize="22" TextColor="{Binding ColorResultado}" HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>