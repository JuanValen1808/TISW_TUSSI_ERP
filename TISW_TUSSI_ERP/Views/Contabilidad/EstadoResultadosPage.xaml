<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.EstadoResultadosPage"
             x:DataType="viewmodels:EstadoResultadosViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto,*">
        
        <StackLayout Grid.Row="0" Padding="20">
            <Label Text="Estado de Resultados" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="Reporte operacional de ingresos y gastos." FontSize="14" TextColor="Gray" Margin="0,5,0,15" />
            
            <Button Text="Generar Reporte" 
                    Command="{Binding CargarEstadoResultadosCommand}"
                    HorizontalOptions="Start" />
        </StackLayout>

        <RefreshView Grid.Row="1" Command="{Binding CargarEstadoResultadosCommand}" IsRefreshing="{Binding EstaOcupado}">
            <ScrollView>
                <VerticalStackLayout Margin="20,0,20,30" Spacing="20">
                    
                    <!-- SECCIÓN INGRESOS -->
                    <Border BackgroundColor="White" Stroke="{StaticResource ErpBorder}" StrokeShape="RoundRectangle 8" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="INGRESOS OPERACIONALES" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" Margin="0,0,0,10" />
                            
                            <Grid ColumnDefinitions="100, *, 150" Padding="5,5" BackgroundColor="#F3F4F6">
                                <Label Grid.Column="0" Text="CÓDIGO" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="CUENTA" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="MONTO" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Ingresos}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                        <Grid ColumnDefinitions="100, *, 150" Padding="5,10">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Ganancia, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            
                            <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" Margin="0,10" />
                            
                            <Grid ColumnDefinitions="*, 150">
                                <Label Grid.Column="0" Text="TOTAL INGRESOS:" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalIngresos, StringFormat='{}{0:N0}'}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SECCIÓN GASTOS -->
                    <Border BackgroundColor="White" Stroke="{StaticResource ErpBorder}" StrokeShape="RoundRectangle 8" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="COSTOS Y GASTOS" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" Margin="0,0,0,10" />
                            
                            <Grid ColumnDefinitions="100, *, 150" Padding="5,5" BackgroundColor="#F3F4F6">
                                <Label Grid.Column="0" Text="CÓDIGO" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="CUENTA" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="MONTO" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Gastos}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                        <Grid ColumnDefinitions="100, *, 150" Padding="5,10">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Perdida, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            
                            <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" Margin="0,10" />
                            
                            <Grid ColumnDefinitions="*, 150">
                                <Label Grid.Column="0" Text="TOTAL GASTOS:" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalGastos, StringFormat='{}{0:N0}'}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RESULTADO FINAL -->
                    <Border BackgroundColor="#F8FAFC" Stroke="{StaticResource ErpBorder}" StrokeShape="RoundRectangle 8" Padding="20">
                        <Grid ColumnDefinitions="*, 200">
                            <Label Grid.Column="0" Text="{Binding TextoResultado}" FontAttributes="Bold" FontSize="18" TextColor="{Binding ColorResultado}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                            <Label Grid.Column="1" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:N0}'}" FontAttributes="Bold" FontSize="20" TextColor="{Binding ColorResultado}" HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
