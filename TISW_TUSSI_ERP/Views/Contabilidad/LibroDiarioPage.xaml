<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.LibroDiarioPage"
             x:DataType="viewmodels:LibroDiarioViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBg}">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Contabilidad › RF-CON-02" Titulo="Libro Diario General (Asientos Automáticos y Manuales)" />

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="24" Spacing="18">

                    <!-- HERO BANNER -->
                    <Border Style="{StaticResource CtbHero}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="REGISTRO CRONOLÓGICO OFICIAL · ART. 27 CÓDIGO DE COMERCIO Y SII CHILE" Style="{StaticResource CtbHeroEyebrow}" />
                                <Label Text="Libro Diario General y Centralización" Style="{StaticResource CtbHeroTitle}" />
                                <Label Text="Asientos contables automáticos generados desde Ventas, Compras e Inventario (IVA 19% y Costo de Venta) más registro de asientos manuales por Partida Doble."
                                       Style="{StaticResource CtbHeroSubtitle}" />
                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                    <Border Style="{StaticResource CtbHeroChip}">
                                        <Label Text="✓ Centralización Ventas / Compras / Mermas" Style="{StaticResource CtbHeroChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource CtbHeroChip}">
                                        <Label Text="✓ Control Partida Doble (Debe = Haber)" Style="{StaticResource CtbHeroChipText}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="+ Nuevo Asiento Manual"
                                            Command="{Binding AbrirModalAsientoCommand}"
                                            Style="{StaticResource CtbHeroButton}" />
                                    <Button Text="⚡ Centralizar Módulos"
                                            Command="{Binding CentralizarAutomaticoCommand}"
                                            Style="{StaticResource CtbHeroGhostButton}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                    <Button Text="Exportar PDF" Command="{Binding ExportarPdfCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                                    <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- BANNER DE PENDIENTES DE CENTRALIZAR DESDE VENTAS / COMPRAS / INVENTARIO -->
                    <Border BackgroundColor="#FFFBEB"
                            Stroke="#FDE68A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16,12"
                            IsVisible="{Binding HayPendientesCentralizar}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="DOCUMENTOS OPERATIVOS LISTOS PARA CENTRALIZACIÓN AUTOMÁTICA"
                                       FontSize="10" FontAttributes="Bold" TextColor="#B45309" />
                                <Label Text="{Binding DetallePendientesTexto}"
                                       FontSize="13" FontAttributes="Bold" TextColor="#78350F" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Generar Asientos Automáticos Ahora"
                                    Command="{Binding CentralizarAutomaticoCommand}"
                                    BackgroundColor="#D97706"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    Padding="16,0" />
                        </Grid>
                    </Border>

                    <!-- BANNERS DE ERROR / ÉXITO -->
                    <Border Style="{StaticResource CtbErrorBanner}" IsVisible="{Binding HayError}">
                        <Label Text="{Binding MensajeError}" TextColor="#991B1B" FontSize="13" FontAttributes="Bold" />
                    </Border>
                    <Border Style="{StaticResource CtbOkBanner}" IsVisible="{Binding HayExito}">
                        <Label Text="{Binding MensajeExito}" TextColor="#065F46" FontSize="13" FontAttributes="Bold" />
                    </Border>

                    <!-- TARJETAS KPI -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#4F46E5" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="ASIENTOS CONTABLES" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding CantidadAsientos}" Style="{StaticResource CtbKpiValue}" />
                                    <Label Text="Folios correlativos SII" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#1D6FD8" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="TOTAL CARGOS (DEBE)" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding TotalDebeTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#1D4ED8" />
                                    <Label Text="Sumatoria débitos del período" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#7C3AED" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="TOTAL ABONOS (HABER)" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding TotalHaberTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#6D28D9" />
                                    <Label Text="Sumatoria créditos del período" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#059669" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="ESTADO DE CUADRATURA" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding EstadoCuadratura}" FontSize="17" FontAttributes="Bold" TextColor="{Binding ColorCuadratura}" />
                                    <Label Text="{Binding DetallePendientesTexto}" Style="{StaticResource CtbKpiHint}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- BARRA DE FILTROS -->
                    <Border Style="{StaticResource CtbFilterBar}">
                        <Grid ColumnDefinitions="150,150,180,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="DESDE" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="HASTA" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="ORIGEN DEL ASIENTO" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <Picker ItemsSource="{Binding OrigenesFiltro}" SelectedItem="{Binding OrigenSeleccionado}" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Label Text="BUSCAR GLOSA, FOLIO O CUENTA" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <Entry Placeholder="Buscar por glosa, N° de asiento o cuenta contable..."
                                           Text="{Binding Busqueda}"
                                           Style="{StaticResource ErpEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Grid.Column="4"
                                    Text="Filtrar"
                                    Command="{Binding CargarAsientosCommand}"
                                    Style="{StaticResource CtbPrimaryButton}"
                                    VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <!-- LISTADO DETALLADO DE ASIENTOS CONTABLES (FORMATO CLÁSICO CHILENO CON DEBE Y HABER) -->
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Asientos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LibroDiarioAsiento">
                                <Border Style="{StaticResource CtbTable}">
                                    <VerticalStackLayout>

                                        <!-- Cabecera del Asiento -->
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                              ColumnSpacing="12"
                                              Padding="18,12"
                                              BackgroundColor="#F8FAFC">
                                            <Border BackgroundColor="#0F172A"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="10,4"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding NumeroTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource CtbPill}"
                                                    BackgroundColor="{Binding OrigenFondo}">
                                                <Label Text="{Binding Origen}"
                                                       Style="{StaticResource CtbPillText}"
                                                       TextColor="{Binding OrigenColor}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding GlosaTexto}" FontAttributes="Bold" FontSize="14" TextColor="#0F172A" />
                                                <Label FontSize="11" TextColor="#64748B">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Fecha contable: " />
                                                            <Span Text="{Binding FechaTexto}" FontAttributes="Bold" />
                                                            <Span Text="  ·  " />
                                                            <Span Text="{Binding TipoAsientoTexto}" />
                                                            <Span Text="  ·  Responsable: " />
                                                            <Span Text="{Binding UsuarioTexto}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <Border Grid.Column="3"
                                                    Style="{StaticResource CtbPill}"
                                                    BackgroundColor="{Binding CuadraturaFondo}">
                                                <Label Text="{Binding EstadoCuadraturaTexto}"
                                                       Style="{StaticResource CtbPillText}"
                                                       TextColor="{Binding CuadraturaColor}" />
                                            </Border>

                                            <Label Grid.Column="4"
                                                   Text="{Binding LineasTexto}"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <BoxView Style="{StaticResource CtbDivider}" />

                                        <!-- Encabezado de Líneas del Asiento -->
                                        <Grid ColumnDefinitions="120,*,150,150" Padding="18,8" BackgroundColor="#FFFFFF">
                                            <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource CtbTh}" />
                                            <Label Grid.Column="1" Text="CUENTA CONTABLE IMPUTADA" Style="{StaticResource CtbTh}" />
                                            <Label Grid.Column="2" Text="DEBE (CARGO)" Style="{StaticResource CtbThRight}" />
                                            <Label Grid.Column="3" Text="HABER (ABONO)" Style="{StaticResource CtbThRight}" />
                                        </Grid>
                                        <BoxView Style="{StaticResource CtbDivider}" />

                                        <!-- Líneas Debe / Haber -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lineas}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:LineaAsiento">
                                                    <VerticalStackLayout>
                                                        <Grid ColumnDefinitions="120,*,150,150" Padding="18,9">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding CodigoCuenta}"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#475569"
                                                                   VerticalOptions="Center" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding CuentaTexto}"
                                                                   Margin="{Binding Sangria}"
                                                                   TextColor="#0F172A"
                                                                   FontSize="13"
                                                                   VerticalOptions="Center" />
                                                            <Label Grid.Column="2"
                                                                   Text="{Binding DebeTexto}"
                                                                   Style="{StaticResource CtbMoneyStrong}"
                                                                   TextColor="#1D4ED8" />
                                                            <Label Grid.Column="3"
                                                                   Text="{Binding HaberTexto}"
                                                                   Style="{StaticResource CtbMoneyStrong}"
                                                                   TextColor="#6D28D9" />
                                                        </Grid>
                                                        <BoxView Style="{StaticResource CtbDivider}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- Pie de Cuadratura del Asiento -->
                                        <Grid ColumnDefinitions="120,*,150,150" Padding="18,10" BackgroundColor="#F1F5F9">
                                            <Label Grid.Column="1"
                                                   Text="SUMAS IGUALES DEL ASIENTO:"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#475569"
                                                   HorizontalTextAlignment="End"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding TotalDebeTexto}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="#0F172A"
                                                   HorizontalTextAlignment="End" />
                                            <Label Grid.Column="3"
                                                   Text="{Binding TotalHaberTexto}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="#0F172A"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- MODAL DE REGISTRO DE ASIENTO CONTABLE MANUAL (PARTIDA DOBLE) -->
            <Grid IsVisible="{Binding MostrarModalAsiento}" BackgroundColor="#800F172A">
                <Border WidthRequest="760"
                        MaximumHeightRequest="660"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        Padding="24">
                    <ScrollView>
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Registrar Asiento Contable Manual" Style="{StaticResource CtbSectionTitle}" FontSize="18" />
                                    <Label Text="Ingresa las imputaciones al Debe y al Haber verificando la cuadratura por Partida Doble."
                                           Style="{StaticResource CtbPageSubtitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#F1F5F9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,6"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding EstadoNuevoAsientoTexto}"
                                           TextColor="{Binding ColorEstadoNuevoAsiento}"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="160,180,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="FECHA ASIENTO" Style="{StaticResource CtbFieldLabel}" />
                                    <Border Style="{StaticResource CtbField}">
                                        <DatePicker Date="{Binding NuevoFecha}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="ORIGEN / TIPO" Style="{StaticResource CtbFieldLabel}" />
                                    <Border Style="{StaticResource CtbField}">
                                        <Picker ItemsSource="{Binding OrigenesManuales}" SelectedItem="{Binding NuevoOrigen}" TextColor="#0F172A" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="GLOSA EXPLICATIVA DEL ASIENTO (OBLIGATORIA SII)" Style="{StaticResource CtbFieldLabel}" />
                                    <Border Style="{StaticResource CtbField}">
                                        <Entry Text="{Binding NuevaGlosa}"
                                               Placeholder="Ej: Provisión gastos generales / Aporte de capital / Ajuste inventario..."
                                               Style="{StaticResource ErpEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Agregar línea de imputación -->
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" Padding="14">
                                <Grid ColumnDefinitions="*,130,130,Auto" ColumnSpacing="10" VerticalOptions="End">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="CUENTA CONTABLE IMPUTABLE" Style="{StaticResource CtbFieldLabel}" />
                                        <Border Style="{StaticResource CtbField}" BackgroundColor="White">
                                            <Picker ItemsSource="{Binding CuentasImputables}"
                                                    ItemDisplayBinding="{Binding Descripcion}"
                                                    SelectedItem="{Binding CuentaLineaSeleccionada}"
                                                    TextColor="#0F172A" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="MONTO DEBE ($)" Style="{StaticResource CtbFieldLabel}" />
                                        <Border Style="{StaticResource CtbField}" BackgroundColor="White">
                                            <Entry Text="{Binding MontoDebeLinea}" Keyboard="Numeric" Placeholder="0" Style="{StaticResource ErpEntry}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="MONTO HABER ($)" Style="{StaticResource CtbFieldLabel}" />
                                        <Border Style="{StaticResource CtbField}" BackgroundColor="White">
                                            <Entry Text="{Binding MontoHaberLinea}" Keyboard="Numeric" Placeholder="0" Style="{StaticResource ErpEntry}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="3"
                                            Text="+ Agregar Línea"
                                            Command="{Binding AgregarLineaCommand}"
                                            Style="{StaticResource CtbPrimaryButton}"
                                            VerticalOptions="End" />
                                </Grid>
                            </Border>

                            <!-- Tabla de líneas agregadas -->
                            <Border Style="{StaticResource CtbTable}">
                                <VerticalStackLayout>
                                    <Grid Style="{StaticResource CtbTableHead}" ColumnDefinitions="*,120,120,90">
                                        <Label Grid.Column="0" Text="CUENTA CONTABLE" Style="{StaticResource CtbTh}" />
                                        <Label Grid.Column="1" Text="DEBE" Style="{StaticResource CtbThRight}" />
                                        <Label Grid.Column="2" Text="HABER" Style="{StaticResource CtbThRight}" />
                                        <Label Grid.Column="3" Text="QUITAR" Style="{StaticResource CtbThRight}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource CtbDivider}" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LineasNuevoAsiento}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:LineaAsientoInput">
                                                <VerticalStackLayout>
                                                    <Grid ColumnDefinitions="*,120,120,90" Padding="14,8">
                                                        <Label Grid.Column="0" Text="{Binding CuentaCompleta}" Style="{StaticResource CtbTdStrong}" />
                                                        <Label Grid.Column="1" Text="{Binding DebeTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#1D4ED8" />
                                                        <Label Grid.Column="2" Text="{Binding HaberTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#6D28D9" />
                                                        <Button Grid.Column="3"
                                                                Text="Quitar"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LibroDiarioViewModel}}, Path=EliminarLineaCommand}"
                                                                CommandParameter="{Binding .}"
                                                                BackgroundColor="#FEF2F2"
                                                                TextColor="#DC2626"
                                                                FontSize="11"
                                                                CornerRadius="6"
                                                                HeightRequest="28"
                                                                Padding="8,0"
                                                                HorizontalOptions="End" />
                                                    </Grid>
                                                    <BoxView Style="{StaticResource CtbDivider}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,120,120,90" Padding="14,10" BackgroundColor="#F1F5F9">
                                        <Label Grid.Column="0" Text="TOTALES DEL ASIENTO:" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding TotalDebeNuevoTexto}" Style="{StaticResource CtbMoneyStrong}" />
                                        <Label Grid.Column="2" Text="{Binding TotalHaberNuevoTexto}" Style="{StaticResource CtbMoneyStrong}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <HorizontalStackLayout HorizontalOptions="End" Spacing="10" Margin="0,6,0,0">
                                <Button Text="Cancelar" Command="{Binding CerrarModalAsientoCommand}" Style="{StaticResource CtbGhostButton}" />
                                <Button Text="Contabilizar Asiento en Libro Diario" Command="{Binding GuardarAsientoManualCommand}" Style="{StaticResource CtbPrimaryButton}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
