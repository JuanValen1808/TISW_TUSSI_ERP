<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.CuentasPorPagarPage"
             x:DataType="viewmodels:CuentasPorPagarViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Header Moderno -->
        <Border Grid.Row="0" Style="{StaticResource ErpCard}" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout>
                    <Label Text="Cuentas por Pagar" Style="{StaticResource ErpTitle}" />
                    <Label Text="Documentos pendientes con proveedores." Style="{StaticResource ErpSubtitle}" Margin="0,0,0,10" />
                    <Button Text="Actualizar Datos" Command="{Binding CargarDocumentosCommand}" Style="{StaticResource ErpPrimaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                    <Label Text="Total por Pagar" Style="{StaticResource ErpSmallLabel}" HorizontalOptions="End"/>
                    <Label Text="{Binding TotalPagar, StringFormat='{0:C0}'}" FontAttributes="Bold" FontSize="22" TextColor="{StaticResource ErpPrimary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Lista de Documentos tipo Tarjeta -->
        <RefreshView Grid.Row="1" Command="{Binding CargarDocumentosCommand}" IsRefreshing="{Binding EstaOcupado}">
            <CollectionView ItemsSource="{Binding Documentos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CuentaPorPagar">
                        <Border Style="{StaticResource ErpCard}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="100, 2*, *, *, 100">

                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="NRO DOC" Style="{StaticResource ErpSmallLabel}" />
                                    <Label Text="{Binding NumeroDocumento}" Style="{StaticResource ErpLabel}" FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="PROVEEDOR" Style="{StaticResource ErpSmallLabel}" />
                                    <Label Text="{Binding Proveedor}" Style="{StaticResource ErpLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="VENCIMIENTO" Style="{StaticResource ErpSmallLabel}" />
                                    <Label Text="{Binding FechaVencimiento, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource ErpLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="SALDO" Style="{StaticResource ErpSmallLabel}" />
                                    <Label Text="{Binding SaldoPendiente, StringFormat='{0:C0}'}" Style="{StaticResource ErpLabel}" FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <!-- Badge de Estado Tipo Píldora -->
                                <Border Grid.Column="4" HorizontalOptions="End" VerticalOptions="Center" 
                                        StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12,6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Pagado">
                                            <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Vencido">
                                            <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Estado}" FontSize="12" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pagado">
                                                <Setter Property="TextColor" Value="#166534" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Vencido">
                                                <Setter Property="TextColor" Value="#991B1B" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pendiente">
                                                <Setter Property="TextColor" Value="#92400E" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>