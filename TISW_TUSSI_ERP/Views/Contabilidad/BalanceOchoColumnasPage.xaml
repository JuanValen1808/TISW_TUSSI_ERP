<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.BalanceOchoColumnasPage"
             x:DataType="viewmodels:BalanceOchoColumnasViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBg}">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Contabilidad › RF-CON-04" Titulo="Balance Tributario de 8 Columnas (Formato SII Chile)" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18">

                <!-- HERO BANNER -->
                <Border Style="{StaticResource CtbHero}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="BALANCE DE COMPROBACIÓN Y SALDOS · FORMATO TRIBUTARIO SII CHILE" Style="{StaticResource CtbHeroEyebrow}" />
                            <Label Text="Balance Tributario de 8 Columnas" Style="{StaticResource CtbHeroTitle}" />
                            <Label Text="Matriz oficial de verificación de Sumas (Débitos/Créditos), Saldos (Deudor/Acreedor), Inventario (Activo/Pasivo) y Resultado (Pérdida/Ganancia)."
                                   Style="{StaticResource CtbHeroSubtitle}" />
                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                <Border Style="{StaticResource CtbHeroChip}">
                                    <Label Text="✓ Cuadratura Automática 8 Columnas" Style="{StaticResource CtbHeroChipText}" />
                                </Border>
                                <Border Style="{StaticResource CtbHeroChip}">
                                    <Label Text="✓ Base Renta Líquida Imponible (Art. 14 D LIR)" Style="{StaticResource CtbHeroChipText}" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                            <Button Text="Generar Balance" Command="{Binding CargarBalanceCommand}" Style="{StaticResource CtbHeroButton}" />
                            <Button Text="Exportar PDF" Command="{Binding ExportarPdfCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                            <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- BANNERS -->
                <Border Style="{StaticResource CtbErrorBanner}" IsVisible="{Binding HayError}">
                    <Label Text="{Binding MensajeError}" TextColor="#991B1B" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border Style="{StaticResource CtbOkBanner}" IsVisible="{Binding HayExito}">
                    <Label Text="{Binding MensajeExito}" TextColor="#065F46" FontSize="13" FontAttributes="Bold" />
                </Border>

                <!-- TARJETAS KPI -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CtbKpiCard}">
                        <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                            <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#4F46E5" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="SUMAS IGUALES (DEBE = HABER)" Style="{StaticResource CtbKpiLabel}" />
                                <Label Text="{Binding SumDebeTexto}" Style="{StaticResource CtbKpiValue}" />
                                <Label Text="Verificación de Partida Doble" Style="{StaticResource CtbKpiHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CtbKpiCard}">
                        <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                            <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#1D6FD8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="TOTAL ACTIVOS (INVENTARIO)" Style="{StaticResource CtbKpiLabel}" />
                                <Label Text="{Binding SumActivoTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#1D4ED8" />
                                <Label Text="Recursos disponibles" Style="{StaticResource CtbKpiHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CtbKpiCard}">
                        <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                            <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#059669" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding TextoResultado}" Style="{StaticResource CtbKpiLabel}" />
                                <Label Text="{Binding ResultadoAbsolutoTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#047857" />
                                <Label Text="Ganancias menos Pérdidas" Style="{StaticResource CtbKpiHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CtbKpiCard}">
                        <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                            <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#D97706" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="PROVISIÓN IDPC (25% PRO PYME)" Style="{StaticResource CtbKpiLabel}" />
                                <Label Text="{Binding ImpuestoRentaEstimadoTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#B45309" />
                                <Label Text="Art. 14 Letra D N°3 LIR" Style="{StaticResource CtbKpiHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BARRA DE FILTROS -->
                <Border Style="{StaticResource CtbFilterBar}">
                    <Grid ColumnDefinitions="180,180,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="DESDE" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbField}">
                                <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="HASTA (CORTE TRIBUTARIO)" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbField}">
                                <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                            <Label Text="Normativa de Cuadratura SII (Formulario 22):" FontSize="12" FontAttributes="Bold" TextColor="#1E293B" />
                            <Label Text="La diferencia entre Activo y Pasivo debe coincidir exactamente con la diferencia entre Ganancia y Pérdida."
                                   FontSize="12" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button Grid.Column="3"
                                Text="Recalcular 8 Columnas"
                                Command="{Binding CargarBalanceCommand}"
                                Style="{StaticResource CtbPrimaryButton}"
                                VerticalOptions="End" />
                    </Grid>
                </Border>

                <!-- MATRIZ DE 8 COLUMNAS -->
                <Border Style="{StaticResource CtbTable}">
                    <ScrollView Orientation="Horizontal">
                        <VerticalStackLayout MinimumWidthRequest="1280">

                            <!-- Nivel Superior de Cabecera Agrupada -->
                            <Grid ColumnDefinitions="90,230,230,230,230,230"
                                  BackgroundColor="#0F172A"
                                  Padding="16,8"
                                  ColumnSpacing="6">
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Text="IDENTIFICACIÓN DE CUENTA" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                                <Border Grid.Column="2" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4">
                                    <Label Text="1 · SUMAS DEL MAYOR" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4">
                                    <Label Text="2 · SALDOS CONTABLES" TextColor="#C4B5FD" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="4" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4">
                                    <Label Text="3 · INVENTARIO (BALANCE)" TextColor="#6EE7B7" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="5" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4">
                                    <Label Text="4 · RESULTADO (EERR)" TextColor="#FCD34D" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Subcabecera de las 8 Columnas -->
                            <Grid ColumnDefinitions="90,230,112,112,112,112,112,112,112,112"
                                  BackgroundColor="#F8FAFC"
                                  Padding="16,10"
                                  ColumnSpacing="6">
                                <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource CtbTh}" />
                                <Label Grid.Column="1" Text="CUENTA CONTABLE" Style="{StaticResource CtbTh}" />
                                <Label Grid.Column="2" Text="DÉBITOS" Style="{StaticResource CtbThRight}" TextColor="#1D4ED8" />
                                <Label Grid.Column="3" Text="CRÉDITOS" Style="{StaticResource CtbThRight}" TextColor="#1D4ED8" />
                                <Label Grid.Column="4" Text="DEUDOR" Style="{StaticResource CtbThRight}" TextColor="#6D28D9" />
                                <Label Grid.Column="5" Text="ACREEDOR" Style="{StaticResource CtbThRight}" TextColor="#6D28D9" />
                                <Label Grid.Column="6" Text="ACTIVO" Style="{StaticResource CtbThRight}" TextColor="#047857" />
                                <Label Grid.Column="7" Text="PASIVO" Style="{StaticResource CtbThRight}" TextColor="#047857" />
                                <Label Grid.Column="8" Text="PÉRDIDA" Style="{StaticResource CtbThRight}" TextColor="#BE123C" />
                                <Label Grid.Column="9" Text="GANANCIA" Style="{StaticResource CtbThRight}" TextColor="#047857" />
                            </Grid>
                            <BoxView Style="{StaticResource CtbDivider}" />

                            <!-- Filas de Cuentas -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="90,230,112,112,112,112,112,112,112,112"
                                                  Padding="16,10"
                                                  ColumnSpacing="6">
                                                <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource CtbTdStrong}" />
                                                <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource CtbTdStrong}" />

                                                <Label Grid.Column="2" Text="{Binding TotalDebeTexto}" Style="{StaticResource CtbMoney}" />
                                                <Label Grid.Column="3" Text="{Binding TotalHaberTexto}" Style="{StaticResource CtbMoney}" />

                                                <Label Grid.Column="4" Text="{Binding SaldoDeudorTexto}" Style="{StaticResource CtbMoney}" />
                                                <Label Grid.Column="5" Text="{Binding SaldoAcreedorTexto}" Style="{StaticResource CtbMoney}" />

                                                <Label Grid.Column="6" Text="{Binding ActivoTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#1D4ED8" />
                                                <Label Grid.Column="7" Text="{Binding PasivoTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#6D28D9" />

                                                <Label Grid.Column="8" Text="{Binding PerdidaTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#BE123C" />
                                                <Label Grid.Column="9" Text="{Binding GananciaTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#047857" />
                                            </Grid>
                                            <BoxView Style="{StaticResource CtbDivider}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- BLOQUE DE CUADRATURA FINAL (3 FILAS OFICIALES SII) -->
                            <VerticalStackLayout BackgroundColor="#0F172A" Padding="16,12" Spacing="8">

                                <!-- 1. Subtotales -->
                                <Grid ColumnDefinitions="90,230,112,112,112,112,112,112,112,112" ColumnSpacing="6">
                                    <Label Grid.Column="0" Grid.ColumnSpan="2" Text="SUBTOTALES DEL PERÍODO:" TextColor="#94A3B8" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding SumDebeTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding SumHaberTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="4" Text="{Binding SumSaldoDeudorTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="5" Text="{Binding SumSaldoAcreedorTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="6" Text="{Binding SumActivoTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="7" Text="{Binding SumPasivoTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="8" Text="{Binding SumPerdidaTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="9" Text="{Binding SumGananciaTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- 2. Utilidad o Pérdida del Ejercicio -->
                                <Grid ColumnDefinitions="90,230,112,112,112,112,112,112,112,112" ColumnSpacing="6">
                                    <Label Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TextoResultado}" TextColor="#93C5FD" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="6" Text="{Binding ResultadoAbsolutoTexto}" IsVisible="{Binding EsPerdida}" TextColor="#FCA5A5" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="7" Text="{Binding ResultadoAbsolutoTexto}" IsVisible="{Binding EsUtilidad}" TextColor="#6EE7B7" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="8" Text="{Binding ResultadoAbsolutoTexto}" IsVisible="{Binding EsUtilidad}" TextColor="#6EE7B7" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="9" Text="{Binding ResultadoAbsolutoTexto}" IsVisible="{Binding EsPerdida}" TextColor="#FCA5A5" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                                <!-- 3. Sumas Iguales -->
                                <Grid ColumnDefinitions="90,230,112,112,112,112,112,112,112,112" ColumnSpacing="6">
                                    <Label Grid.Column="0" Grid.ColumnSpan="2" Text="SUMAS IGUALES (CUADRATURA SII):" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding SumDebeTexto}" TextColor="#F8FAFC" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding SumHaberTexto}" TextColor="#F8FAFC" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="4" Text="{Binding SumSaldoDeudorTexto}" TextColor="#F8FAFC" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="5" Text="{Binding SumSaldoAcreedorTexto}" TextColor="#F8FAFC" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="6" Text="{Binding TotalFinalActivoTexto}" TextColor="#6EE7B7" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="7" Text="{Binding TotalFinalPasivoTexto}" TextColor="#6EE7B7" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="8" Text="{Binding TotalFinalPerdidaTexto}" TextColor="#FCD34D" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="9" Text="{Binding TotalFinalGananciaTexto}" TextColor="#FCD34D" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
