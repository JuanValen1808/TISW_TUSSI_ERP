<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.BalanceOchoColumnasPage"
             x:DataType="viewmodels:BalanceOchoColumnasViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- HEADER MODERNO -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <VerticalStackLayout>
                <Label Text="Balance de 8 Columnas" Style="{StaticResource ErpTitle}" />
                <Label Text="Comprobación, saldos y estado tributario." Style="{StaticResource ErpSubtitle}" Margin="0,0,0,10" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Generar Balance" Command="{Binding CargarBalanceCommand}" Style="{StaticResource ErpPrimaryButton}" VerticalOptions="Center" />
        </Grid>

        <!-- TABLA DE DATOS CONTENIDA EN TARJETA -->
        <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="0">
            <RefreshView Command="{Binding CargarBalanceCommand}" IsRefreshing="{Binding EstaOcupado}">
                <ScrollView Orientation="Horizontal">
                    <VerticalStackLayout MinimumWidthRequest="1200">

                        <!-- Cabecera de la Tabla -->
                        <Grid ColumnDefinitions="100, 200, 100, 100, 100, 100, 100, 100, 100, 100" Padding="15,10" BackgroundColor="#F1F5F9">
                            <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" VerticalOptions="End" />
                            <Label Grid.Column="1" Text="CUENTA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" VerticalOptions="End" />

                            <Label Grid.Column="2" Grid.ColumnSpan="2" Text="SUMAS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="2" Text="DÉBITOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="3" Text="CRÉDITOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />

                            <Label Grid.Column="4" Grid.ColumnSpan="2" Text="SALDOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="4" Text="DEUDOR" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="5" Text="ACREEDOR" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />

                            <Label Grid.Column="6" Grid.ColumnSpan="2" Text="INVENTARIO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="6" Text="ACTIVO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="7" Text="PASIVO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />

                            <Label Grid.Column="8" Grid.ColumnSpan="2" Text="RESULTADO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="8" Text="PÉRDIDA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="9" Text="GANANCIA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Filas de Datos -->
                        <CollectionView ItemsSource="{Binding Items}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:BalanceOchoColumnasItem">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="100, 200, 100, 100, 100, 100, 100, 100, 100, 100" Padding="15,12">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource ErpSmallLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource ErpLabel}" FontAttributes="Bold" VerticalOptions="Center" />

                                            <Label Grid.Column="2" Text="{Binding TotalDebe, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="3" Text="{Binding TotalHaber, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />

                                            <Label Grid.Column="4" Text="{Binding SaldoDeudor, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="5" Text="{Binding SaldoAcreedor, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />

                                            <Label Grid.Column="6" Text="{Binding Activo, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="7" Text="{Binding Pasivo, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />

                                            <Label Grid.Column="8" Text="{Binding Perdida, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="9" Text="{Binding Ganancia, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource ErpBackground}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Border>

        <!-- SECCIÓN INFERIOR: TOTALES (Tarjeta Flotante) -->
        <Border Grid.Row="2" Style="{StaticResource ErpCard}" Margin="0,15,0,0" Padding="0" BackgroundColor="#0F172A">
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout MinimumWidthRequest="1200" Padding="15,15">

                    <!-- Subtotales -->
                    <Grid ColumnDefinitions="100, 200, 100, 100, 100, 100, 100, 100, 100, 100" Padding="0,5">
                        <Label Grid.Column="1" Text="SUBTOTALES:" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" FontSize="12" />

                        <Label Grid.Column="2" Text="{Binding SumDebe, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="3" Text="{Binding SumHaber, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="4" Text="{Binding SumSaldoDeudor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="5" Text="{Binding SumSaldoAcreedor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="6" Text="{Binding SumActivo, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="7" Text="{Binding SumPasivo, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="8" Text="{Binding SumPerdida, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="9" Text="{Binding SumGanancia, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                    </Grid>

                    <!-- Resultado del Ejercicio -->
                    <Grid ColumnDefinitions="100, 200, 100, 100, 100, 100, 100, 100, 100, 100" Padding="0,5">
                        <Label Grid.Column="1" Text="{Binding TextoResultado}" FontAttributes="Bold" TextColor="{StaticResource ErpPrimaryLight}" VerticalOptions="Center" HorizontalTextAlignment="End" FontSize="12" />

                        <Label Grid.Column="6" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:N0}'}" IsVisible="{Binding EsPerdida}" HorizontalTextAlignment="End" FontSize="13" TextColor="#FCA5A5" FontAttributes="Bold" />
                        <Label Grid.Column="7" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:N0}'}" IsVisible="{Binding EsUtilidad}" HorizontalTextAlignment="End" FontSize="13" TextColor="#86EFAC" FontAttributes="Bold" />

                        <Label Grid.Column="8" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:N0}'}" IsVisible="{Binding EsUtilidad}" HorizontalTextAlignment="End" FontSize="13" TextColor="#86EFAC" FontAttributes="Bold" />
                        <Label Grid.Column="9" Text="{Binding ResultadoEjercicio, StringFormat='{}{0:N0}'}" IsVisible="{Binding EsPerdida}" HorizontalTextAlignment="End" FontSize="13" TextColor="#FCA5A5" FontAttributes="Bold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F5FEFD" Margin="0,10" />

                    <!-- Totales Iguales -->
                    <Grid ColumnDefinitions="100, 200, 100, 100, 100, 100, 100, 100, 100, 100" Padding="0,5">
                        <Label Grid.Column="1" Text="TOTALES IGUALES:" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" FontSize="12" />

                        <Label Grid.Column="2" Text="{Binding SumDebe, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="3" Text="{Binding SumHaber, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="4" Text="{Binding SumSaldoDeudor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="5" Text="{Binding SumSaldoAcreedor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="6" Text="{Binding TotalFinalActivo, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="7" Text="{Binding TotalFinalPasivo, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="8" Text="{Binding TotalFinalPerdida, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                        <Label Grid.Column="9" Text="{Binding TotalFinalGanancia, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="13" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
