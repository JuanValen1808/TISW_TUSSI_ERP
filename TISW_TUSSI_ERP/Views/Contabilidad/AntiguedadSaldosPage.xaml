<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.AntiguedadSaldosPage"
             Shell.NavBarIsVisible="False"
             Title="Antigüedad de Saldos"
             BackgroundColor="{StaticResource CtbSurfaceAlt}">

    <Grid RowDefinitions="Auto, *">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Contabilidad › RF-CON-08" Titulo="Reporte de Antigüedad de Saldos (Aging Report)" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18">

                <!-- HERO BANNER -->
                <Border Style="{StaticResource CtbHero}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#2563EB" StrokeThickness="0" Padding="8,3" StrokeShape="RoundRectangle 6">
                                    <Label Text="RF-CON-08 · TRAMOS DE MOROSIDAD" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" Padding="8,3" StrokeShape="RoundRectangle 6">
                                    <Label Text="{Binding DescripcionModo}" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Reporte de Antigüedad de Saldos (CxC / CxP)" Style="{StaticResource CtbHeroTitle}" />
                            <Label Text="Desglose de obligaciones pendientes agrupadas por tramos de morosidad (Vigente, 1–30, 31–60, 61–90 y +90 días)." Style="{StaticResource CtbHeroSubtitle}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Button Text="Exportar PDF" Command="{Binding ExportarPdfCommand}" Style="{StaticResource CtbBtnPrimary}" />
                            <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}" Style="{StaticResource CtbBtnOutline}" BackgroundColor="#1E293B" TextColor="White" BorderColor="#475569" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- BARRA DE FILTROS / SELECTOR CXC vs CXP -->
                <Border Style="{StaticResource CtbFilterBar}">
                    <Grid ColumnDefinitions="Auto, 180, Auto, *" ColumnSpacing="16" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="CARTERA A ANALIZAR" Style="{StaticResource CtbFieldLabel}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Cuentas por Cobrar (Clientes)"
                                        Command="{Binding CambiarModoCommand}"
                                        CommandParameter="CXC"
                                        Style="{StaticResource CtbBtnPrimary}"
                                        HeightRequest="38" />
                                <Button Text="Cuentas por Pagar (Proveedores)"
                                        Command="{Binding CambiarModoCommand}"
                                        CommandParameter="CXP"
                                        Style="{StaticResource CtbBtnOutline}"
                                        HeightRequest="38" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="FECHA DE CORTE" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbInputBox}">
                                <DatePicker Date="{Binding FechaCorte}" Format="dd/MM/yyyy" TextColor="{StaticResource CtbText}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Grid.Column="2" Text="Recalcular Tramos" Command="{Binding CargarCommand}" Style="{StaticResource CtbBtnPrimary}" VerticalOptions="End" />
                    </Grid>
                </Border>

                <!-- KPIS GENERALES -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CtbKpiCard}" Stroke="#BFDBFE">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SALDO TOTAL CARTERA" Style="{StaticResource CtbKpiLabel}" TextColor="#1D4ED8" />
                            <Label Text="{Binding TotalTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#1D4ED8" />
                            <Label Text="{Binding CantidadDocumentos, StringFormat='{0} documentos abiertos'}" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CtbKpiCard}" Stroke="#FECDD3">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL EN MORA (VENCIDO)" Style="{StaticResource CtbKpiLabel}" TextColor="#BE123C" />
                            <Label Text="{Binding VencidoTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#BE123C" />
                            <Label Text="Tramos &gt; 0 días vencidos" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CtbKpiCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ÍNDICE DE MOROSIDAD" Style="{StaticResource CtbKpiLabel}" />
                            <Label Text="{Binding PorcentajeVencidoTexto}" Style="{StaticResource CtbKpiValue}" />
                            <Label Text="Proporción vencida sobre el total" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CtbKpiCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="MORA PROMEDIO PONDERADA" Style="{StaticResource CtbKpiLabel}" />
                            <Label Text="{Binding MoraPromedioTexto}" Style="{StaticResource CtbKpiValue}" />
                            <Label Text="Días de atraso ponderado por monto" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- TARJETAS DE LOS 5 TRAMOS DE MOROSIDAD -->
                <Border Style="{StaticResource CtbTable}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="DISTRIBUCIÓN POR TRAMOS DE VENCIMIENTO" Style="{StaticResource CtbSectionTitle}" />
                        <CollectionView ItemsSource="{Binding Tramos}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TramoAntiguedad">
                                    <Border BackgroundColor="{Binding Fondo}" Stroke="{Binding Color}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="12" TextColor="{Binding Color}" />
                                            <Label Text="{Binding MontoTexto}" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource CtbText}" />
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Text="{Binding CantidadTexto}" FontSize="11" TextColor="{StaticResource CtbTextMuted}" />
                                                <Label Grid.Column="1" Text="{Binding PorcentajeTexto}" FontAttributes="Bold" FontSize="11" TextColor="{Binding Color}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- MATRIZ DE ANTIGÜEDAD AGRUPADA POR CLIENTE / PROVEEDOR -->
                <Border Style="{StaticResource CtbTable}">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#0F172A" Padding="16,12" ColumnDefinitions="*, Auto">
                            <Label Text="1. MATRIZ DE ANTIGÜEDAD POR TERCERO (RUT)" TextColor="White" FontAttributes="Bold" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding TotalGeneral, StringFormat='Total Cartera: {0}'}" TextColor="#93C5FD" FontAttributes="Bold" FontSize="12" />
                        </Grid>

                        <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="*, 110, 120, 120, 120, 120, 120, 130">
                            <Label Grid.Column="0" Text="{Binding EtiquetaTercero}" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="1" Text="RUT" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="2" Text="VIGENTE" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#047857" />
                            <Label Grid.Column="3" Text="1–30 DÍAS" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#1D4ED8" />
                            <Label Grid.Column="4" Text="31–60 DÍAS" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#B45309" />
                            <Label Grid.Column="5" Text="61–90 DÍAS" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#C2410C" />
                            <Label Grid.Column="6" Text="+90 DÍAS" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#BE123C" />
                            <Label Grid.Column="7" Text="SALDO TOTAL" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Terceros}">
                            <CollectionView.EmptyView>
                                <Label Text="No existen saldos pendientes para mostrar." Padding="24" HorizontalTextAlignment="Center" TextColor="{StaticResource CtbTextMuted}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TerceroAntiguedad">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,11" ColumnDefinitions="*, 110, 120, 120, 120, 120, 120, 130" BackgroundColor="White">
                                            <Label Grid.Column="0" Text="{Binding Tercero}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource CtbText}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Rut}" FontSize="12" TextColor="{StaticResource CtbTextMuted}" />
                                            <Label Grid.Column="2" Text="{Binding T0Texto}" FontSize="12" TextColor="#047857" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="3" Text="{Binding T1Texto}" FontSize="12" TextColor="#1D4ED8" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="4" Text="{Binding T2Texto}" FontSize="12" TextColor="#B45309" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="5" Text="{Binding T3Texto}" FontSize="12" TextColor="#C2410C" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="6" Text="{Binding T4Texto}" FontSize="12" TextColor="#BE123C" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="7" Text="{Binding TotalTexto}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource CtbText}" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView Style="{StaticResource CtbDivider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- DETALLE DE DOCUMENTOS ABIERTOS -->
                <Border Style="{StaticResource CtbTable}">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#1E293B" Padding="16,12">
                            <Label Text="2. DETALLE DE DOCUMENTOS POR TRAMO DE MOROSIDAD" TextColor="White" FontAttributes="Bold" FontSize="13" />
                        </Grid>

                        <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="120, *, 100, 100, 100, 120, 130, 130">
                            <Label Grid.Column="0" Text="DOCUMENTO" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="1" Text="{Binding EtiquetaTercero}" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="2" Text="EMISIÓN" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="VENCIMIENTO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="DÍAS MORA" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="TRAMO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="MONTO ORIG." Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="7" Text="SALDO PEND." Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Documentos}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentoAntiguedad">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,10" ColumnDefinitions="120, *, 100, 100, 100, 120, 130, 130" BackgroundColor="White">
                                            <Label Grid.Column="0" Text="{Binding Documento}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource CtbPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Tercero}" FontSize="12" TextColor="{StaticResource CtbText}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding EmisionTexto}" FontSize="12" TextColor="{StaticResource CtbText}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding VencimientoTexto}" FontSize="12" TextColor="{StaticResource CtbText}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding DiasTexto}" FontAttributes="Bold" FontSize="12" TextColor="{Binding TramoColor}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            <Border Grid.Column="5" BackgroundColor="{Binding TramoFondo}" StrokeThickness="0" Padding="8,3" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding Tramo}" TextColor="{Binding TramoColor}" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                            <Label Grid.Column="6" Text="{Binding MontoTexto}" FontSize="12" TextColor="{StaticResource CtbTextMuted}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            <Label Grid.Column="7" Text="{Binding SaldoTexto}" FontAttributes="Bold" FontSize="12" TextColor="{Binding TramoColor}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView Style="{StaticResource CtbDivider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
