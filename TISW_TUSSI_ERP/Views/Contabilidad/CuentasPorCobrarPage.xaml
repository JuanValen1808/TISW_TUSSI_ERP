<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.CuentasPorCobrarPage"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Header Moderno -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout>
                    <Label Text="Cuentas por Cobrar" Style="{StaticResource HeaderTitleStyle}" />
                    <Label Text="Documentos pendientes de clientes." TextColor="{StaticResource SecondaryText}" FontSize="14" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                    <Label Text="Total por Cobrar" TextColor="{StaticResource SecondaryText}" FontSize="12" HorizontalOptions="End"/>
                    <Label Text="{Binding TotalCobrar, StringFormat='{0:C0}'}" FontAttributes="Bold" FontSize="22" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Lista de Documentos tipo Tarjeta -->
        <RefreshView Grid.Row="1" Command="{Binding CargarDocumentosCommand}" IsRefreshing="{Binding EstaOcupado}">
            <CollectionView ItemsSource="{Binding Documentos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CuentaPorCobrar">
                        <!-- Tarjeta de fila -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="15">
                            <Grid ColumnDefinitions="100, 2*, *, *, 100">

                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="NRO DOC" FontSize="10" TextColor="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding NumeroDocumento}" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="CLIENTE" FontSize="10" TextColor="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding Cliente}" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="VENCIMIENTO" FontSize="10" TextColor="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding FechaVencimiento, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="SALDO" FontSize="10" TextColor="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding SaldoPendiente, StringFormat='{0:C0}'}" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                </VerticalStackLayout>

                                <!-- Badge de Estado Tipo Píldora -->
                                <Border Grid.Column="4" HorizontalOptions="End" VerticalOptions="Center" 
                                        StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12,6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Pagado">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Vencido">
                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerBg}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="BackgroundColor" Value="{StaticResource WarningBg}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Estado}" FontSize="12" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pagado">
                                                <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Vencido">
                                                <Setter Property="TextColor" Value="{StaticResource DangerText}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pendiente">
                                                <Setter Property="TextColor" Value="{StaticResource WarningText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
