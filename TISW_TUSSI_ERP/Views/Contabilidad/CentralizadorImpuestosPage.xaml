<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.CentralizadorImpuestosPage"
             Shell.NavBarIsVisible="False"
             Title="Centralizador de Impuestos (F29 SII)"
             BackgroundColor="{StaticResource CtbSurfaceAlt}">

    <Grid RowDefinitions="Auto, *">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Contabilidad › RF-CON-09" Titulo="Reporte Centralizador de Impuestos y Formulario 29 SII" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18">

                <!-- HERO BANNER -->
                <Border Style="{StaticResource CtbHero}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#2563EB" StrokeThickness="0" Padding="8,3" StrokeShape="RoundRectangle 6">
                                    <Label Text="RF-CON-09 · DECLARACIÓN MENSUAL F29 SII CHILE" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" Padding="8,3" StrokeShape="RoundRectangle 6">
                                    <Label Text="D.L. N° 825 IVA 19% + PPM ART. 84 LIR" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Registro de Compras y Ventas (RCV) y Formulario 29" Style="{StaticResource CtbHeroTitle}" />
                            <Label Text="{Binding PeriodoTexto, StringFormat='Período Tributario: {0} · Cálculo automático de Neto, IVA Débito Fiscal, IVA Crédito Fiscal y PPM'}" Style="{StaticResource CtbHeroSubtitle}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Button Text="Contabilizar Liquidación IVA" Command="{Binding ContabilizarLiquidacionIvaCommand}" Style="{StaticResource CtbBtnSuccess}" />
                            <Button Text="Exportar F29 PDF" Command="{Binding ExportarPdfCommand}" Style="{StaticResource CtbBtnPrimary}" />
                            <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}" Style="{StaticResource CtbBtnOutline}" BackgroundColor="#1E293B" TextColor="White" BorderColor="#475569" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- BARRA DE FILTROS -->
                <Border Style="{StaticResource CtbFilterBar}">
                    <Grid ColumnDefinitions="160, 160, 150, Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="DESDE" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbInputBox}">
                                <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy" TextColor="{StaticResource CtbText}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="HASTA" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbInputBox}">
                                <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy" TextColor="{StaticResource CtbText}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="TASA PPM (%)" Style="{StaticResource CtbFieldLabel}" />
                            <Border Style="{StaticResource CtbInputBox}">
                                <Entry Text="{Binding TasaPpmPorcentaje}" Keyboard="Numeric" TextColor="{StaticResource CtbText}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Grid.Column="3" Text="Calcular RCV y F29" Command="{Binding CargarCommand}" Style="{StaticResource CtbBtnPrimary}" VerticalOptions="End" />

                        <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="End">
                            <Button Text="Mes actual" Command="{Binding RangoMesActualCommand}" Style="{StaticResource CtbChip}" />
                            <Button Text="Trimestre" Command="{Binding RangoTrimestreCommand}" Style="{StaticResource CtbChip}" />
                            <Button Text="Año actual" Command="{Binding RangoAnioActualCommand}" Style="{StaticResource CtbChip}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- KPIS TRIBUTARIOS SII -->
                <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CtbKpiCard}" Stroke="#BFDBFE">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="IVA DÉBITO FISCAL (538)" Style="{StaticResource CtbKpiLabel}" TextColor="#1D4ED8" />
                            <Label Text="{Binding VentasIvaTexto}" Style="{StaticResource CtbKpiValue}" FontSize="19" TextColor="#1D4ED8" />
                            <Label Text="{Binding VentasNetoTexto, StringFormat='Ventas Netas: {0}'}" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CtbKpiCard}" Stroke="#A7F3D0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="IVA CRÉDITO FISCAL (537)" Style="{StaticResource CtbKpiLabel}" TextColor="#047857" />
                            <Label Text="{Binding ComprasIvaTexto}" Style="{StaticResource CtbKpiValue}" FontSize="19" TextColor="#047857" />
                            <Label Text="{Binding ComprasNetoTexto, StringFormat='Compras Netas: {0}'}" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CtbKpiCard}" BackgroundColor="{Binding EstadoIvaFondo}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding EstadoIvaEtiqueta}" Style="{StaticResource CtbKpiLabel}" TextColor="{Binding EstadoIvaColor}" />
                            <Label Text="{Binding IvaDeterminadoTexto}" Style="{StaticResource CtbKpiValue}" FontSize="19" TextColor="{Binding EstadoIvaColor}" />
                            <Label Text="Diferencia Débito vs Crédito" Style="{StaticResource CtbKpiFoot}" TextColor="{Binding EstadoIvaColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CtbKpiCard}" Stroke="#FDE68A">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="PPM OBLIGATORIO (062)" Style="{StaticResource CtbKpiLabel}" TextColor="#B45309" />
                            <Label Text="{Binding PpmMontoTexto}" Style="{StaticResource CtbKpiValue}" FontSize="19" TextColor="#B45309" />
                            <Label Text="Art. 84 Ley Impuesto Renta" Style="{StaticResource CtbKpiFoot}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CtbKpiCard}" BackgroundColor="#0F172A">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL F29 A PAGAR (091)" Style="{StaticResource CtbKpiLabel}" TextColor="#93C5FD" />
                            <Label Text="{Binding TotalF29Texto}" Style="{StaticResource CtbKpiValue}" FontSize="19" TextColor="#6EE7B7" />
                            <Label Text="Vencimiento día 20 mes sig." Style="{StaticResource CtbKpiFoot}" TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- SECCIÓN 1: SIMULADOR OFICIAL FORMULARIO 29 SII + RESUMEN DTE -->
                <Grid ColumnDefinitions="1.15*, *" ColumnSpacing="18">

                    <!-- FORMULARIO 29 SII -->
                    <Border Grid.Column="0" Style="{StaticResource CtbTable}">
                        <VerticalStackLayout Spacing="0">
                            <Grid BackgroundColor="#0F172A" Padding="16,12" ColumnDefinitions="*, Auto">
                                <VerticalStackLayout>
                                    <Label Text="SIMULADOR DECLARACIÓN FORMULARIO 29 (SII CHILE)" TextColor="White" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="Códigos oficiales de declaración mensual y pago simultáneo" TextColor="#94A3B8" FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#1E293B" Padding="8,4" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                    <Label Text="FORMULARIO 29" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="65, *, 95, 130">
                                <Label Grid.Column="0" Text="CÓD." Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="GLOSA TRIBUTARIA SII" Style="{StaticResource CtbTableHeaderText}" />
                                <Label Grid.Column="2" Text="OPERACIÓN" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="MONTO CLP" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding LineasFormulario29}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LineaFormulario29Item">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Padding="14,11" ColumnDefinitions="65, *, 95, 130" BackgroundColor="{Binding FondoFila}">
                                                <Border Grid.Column="0" BackgroundColor="#E2E8F0" StrokeThickness="0" Padding="6,3" StrokeShape="RoundRectangle 5" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding CodigoSii}" FontAttributes="Bold" FontSize="11" TextColor="#0F172A" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Glosa}" FontSize="12" TextColor="{StaticResource CtbText}" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding Naturaleza}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ColorTexto}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="3" Text="{Binding MontoTexto}" FontAttributes="Bold" FontSize="13" TextColor="{Binding ColorTexto}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView Style="{StaticResource CtbDivider}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RESUMEN POR TIPO DE DTE SII -->
                    <Border Grid.Column="1" Style="{StaticResource CtbTable}">
                        <VerticalStackLayout Spacing="0">
                            <Grid BackgroundColor="#1E293B" Padding="16,12">
                                <VerticalStackLayout>
                                    <Label Text="RESUMEN CONSOLIDADO POR TIPO DE DTE (RCV SII)" TextColor="White" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="Cuadratura por código de Documento Tributario Electrónico" TextColor="#94A3B8" FontSize="11" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="60, *, 55, 100, 95, 105">
                                <Label Grid.Column="0" Text="DTE" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="TIPO DOCUMENTO" Style="{StaticResource CtbTableHeaderText}" />
                                <Label Grid.Column="2" Text="CANT." Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="NETO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                                <Label Grid.Column="4" Text="IVA 19%" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                                <Label Grid.Column="5" Text="TOTAL" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding ResumenDte}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ResumenDteSiiItem">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Padding="12,11" ColumnDefinitions="60, *, 55, 100, 95, 105" BackgroundColor="White">
                                                <Border Grid.Column="0" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" Padding="6,3" StrokeShape="RoundRectangle 5" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding CodigoDte}" FontAttributes="Bold" FontSize="11" TextColor="#1D4ED8" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding NombreDte}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource CtbText}" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding TipoRegistro}" FontSize="10" TextColor="{StaticResource CtbTextMuted}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding CantidadDocumentos}" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="3" Text="{Binding MontoNetoTexto}" FontSize="11" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                                <Label Grid.Column="4" Text="{Binding MontoIvaTexto}" FontAttributes="Bold" FontSize="11" TextColor="#1D4ED8" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                                <Label Grid.Column="5" Text="{Binding MontoTotalTexto}" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView Style="{StaticResource CtbDivider}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- SECCIÓN 2: LIBRO DE VENTAS DETALLADO -->
                <Border Style="{StaticResource CtbTable}">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#0F172A" Padding="16,12" ColumnDefinitions="*, Auto">
                            <Label Text="1. LIBRO DE VENTAS EMITIDAS (IVA DÉBITO FISCAL)" TextColor="White" FontAttributes="Bold" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding VentasTotalTexto, StringFormat='Total Ventas Brutas: {0}'}" TextColor="#93C5FD" FontAttributes="Bold" FontSize="12" />
                        </Grid>

                        <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="95, 130, 120, 110, *, 120, 115, 125">
                            <Label Grid.Column="0" Text="FECHA" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="1" Text="TIPO DTE" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="2" Text="FOLIO" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="3" Text="RUT CLIENTE" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="4" Text="RAZÓN SOCIAL CLIENTE" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="5" Text="MONTO NETO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="6" Text="IVA DÉBITO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#1D4ED8" />
                            <Label Grid.Column="7" Text="MONTO TOTAL" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding LibroVentas}">
                            <CollectionView.EmptyView>
                                <Label Text="No hay ventas afectas emitidas en el período seleccionado." Padding="24" HorizontalTextAlignment="Center" TextColor="{StaticResource CtbTextMuted}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentoLibroVentasItem">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,10" ColumnDefinitions="95, 130, 120, 110, *, 120, 115, 125" BackgroundColor="White">
                                            <Label Grid.Column="0" Text="{Binding FechaTexto}" FontSize="12" TextColor="{StaticResource CtbText}" />
                                            <Label Grid.Column="1" Text="{Binding TipoDte}" FontSize="11" TextColor="{StaticResource CtbTextMuted}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding Folio}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource CtbPrimary}" />
                                            <Label Grid.Column="3" Text="{Binding RutCliente}" FontSize="12" TextColor="{StaticResource CtbTextMuted}" />
                                            <Label Grid.Column="4" Text="{Binding RazonSocial}" FontSize="12" TextColor="{StaticResource CtbText}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="5" Text="{Binding MontoNetoTexto}" FontSize="12" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="6" Text="{Binding MontoIvaTexto}" FontAttributes="Bold" FontSize="12" TextColor="#1D4ED8" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="7" Text="{Binding MontoTotalTexto}" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView Style="{StaticResource CtbDivider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN 3: LIBRO DE COMPRAS DETALLADO -->
                <Border Style="{StaticResource CtbTable}">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#065F46" Padding="16,12" ColumnDefinitions="*, Auto">
                            <Label Text="2. LIBRO DE COMPRAS RECEPCIONADAS (IVA CRÉDITO FISCAL RECUPERABLE)" TextColor="White" FontAttributes="Bold" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding ComprasTotalTexto, StringFormat='Total Compras Brutas: {0}'}" TextColor="#A7F3D0" FontAttributes="Bold" FontSize="12" />
                        </Grid>

                        <Grid Style="{StaticResource CtbTableHeader}" ColumnDefinitions="95, 130, 120, 110, *, 120, 115, 125">
                            <Label Grid.Column="0" Text="FECHA" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="1" Text="TIPO DTE" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="2" Text="N° FACTURA" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="3" Text="RUT PROV." Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="4" Text="RAZÓN SOCIAL PROVEEDOR" Style="{StaticResource CtbTableHeaderText}" />
                            <Label Grid.Column="5" Text="MONTO NETO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="6" Text="IVA CRÉDITO" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" TextColor="#047857" />
                            <Label Grid.Column="7" Text="MONTO TOTAL" Style="{StaticResource CtbTableHeaderText}" HorizontalTextAlignment="End" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding LibroCompras}">
                            <CollectionView.EmptyView>
                                <Label Text="No hay facturas de compra recepcionadas en el período seleccionado." Padding="24" HorizontalTextAlignment="Center" TextColor="{StaticResource CtbTextMuted}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentoLibroComprasItem">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,10" ColumnDefinitions="95, 130, 120, 110, *, 120, 115, 125" BackgroundColor="White">
                                            <Label Grid.Column="0" Text="{Binding FechaTexto}" FontSize="12" TextColor="{StaticResource CtbText}" />
                                            <Label Grid.Column="1" Text="{Binding TipoDte}" FontSize="11" TextColor="{StaticResource CtbTextMuted}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding Folio}" FontAttributes="Bold" FontSize="12" TextColor="#047857" />
                                            <Label Grid.Column="3" Text="{Binding RutProveedor}" FontSize="12" TextColor="{StaticResource CtbTextMuted}" />
                                            <Label Grid.Column="4" Text="{Binding RazonSocial}" FontSize="12" TextColor="{StaticResource CtbText}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="5" Text="{Binding MontoNetoTexto}" FontSize="12" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="6" Text="{Binding MontoIvaTexto}" FontAttributes="Bold" FontSize="12" TextColor="#047857" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="7" Text="{Binding MontoTotalTexto}" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView Style="{StaticResource CtbDivider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
