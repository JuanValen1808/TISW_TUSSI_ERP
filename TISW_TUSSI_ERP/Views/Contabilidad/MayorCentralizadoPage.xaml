<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.MayorCentralizadoPage"
             x:DataType="viewmodels:MayorCentralizadoViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- HEADER Y PANEL DE FILTROS -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">

            <VerticalStackLayout>
                <Label Text="Mayor Centralizado" Style="{StaticResource ErpTitle}" />
                <Label Text="Consulta de movimientos y saldos por cuenta." Style="{StaticResource ErpSubtitle}" />
            </VerticalStackLayout>

            <!-- Tarjeta de Filtros -->
            <Border Style="{StaticResource ErpCard}" Padding="15">
                <Grid ColumnDefinitions="*, *, *, Auto" ColumnSpacing="15" VerticalOptions="End">

                    <!-- Filtro: Cuenta -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="CUENTA CONTABLE" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Border Style="{StaticResource ErpInputBox}">
                            <Picker ItemsSource="{Binding CuentasFiltro}" 
                                    ItemDisplayBinding="{Binding NombreCuenta}"
                                    SelectedItem="{Binding CuentaSeleccionada}"
                                    TextColor="{StaticResource ErpPrimaryText}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Filtro: Fecha Desde -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="DESDE" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Border Style="{StaticResource ErpInputBox}">
                            <DatePicker Date="{Binding FechaDesde}" 
                                        TextColor="{StaticResource ErpPrimaryText}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Filtro: Fecha Hasta -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="HASTA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Border Style="{StaticResource ErpInputBox}">
                            <DatePicker Date="{Binding FechaHasta}" 
                                        TextColor="{StaticResource ErpPrimaryText}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botón Buscar -->
                    <Button Grid.Column="3" Text="Buscar" 
                            Command="{Binding BuscarCommand}" 
                            Style="{StaticResource ErpPrimaryButton}" 
                            VerticalOptions="End" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- TABLA DE RESULTADOS -->
        <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="0">
            <RefreshView Command="{Binding BuscarCommand}" IsRefreshing="{Binding EstaOcupado}">
                <VerticalStackLayout>

                    <!-- Cabecera de la Tabla -->
                    <Grid ColumnDefinitions="100, 100, *, 120, 120" Padding="15,12" BackgroundColor="#F1F5F9">
                        <Label Grid.Column="0" Text="FECHA" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="ASIENTO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="GLOSA / DESCRIPCIÓN" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="DEBE" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Grid.Column="4" Text="HABER" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MayorCentralizadoItem">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="100, 100, *, 120, 120" Padding="15,12">
                                        <Label Grid.Column="0" Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding NumeroAsiento}" Style="{StaticResource ErpLabel}" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Glosa}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" />

                                        <Label Grid.Column="3" Text="{Binding Debe, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Label Grid.Column="4" Text="{Binding Haber, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" Opacity="0.5" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Empty State por defecto si no hay items -->
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40" Spacing="10">
                                <Label Text="Realiza una búsqueda para ver los movimientos." Style="{StaticResource ErpSubtitle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                </VerticalStackLayout>
            </RefreshView>
        </Border>

        <!-- SECCIÓN DE TOTALES -->
        <Border Grid.Row="2" Style="{StaticResource ErpCard}" Margin="0,15,0,0" Padding="15" BackgroundColor="#F8FAFC">
            <Grid ColumnDefinitions="*, 120, 120">
                <Label Grid.Column="0" Text="TOTALES DEL PERIODO:" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                <Label Grid.Column="1" Text="{Binding TotalDebeFiltro, StringFormat='{}{0:C0}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpPrimaryText}" HorizontalTextAlignment="End" />
                <Label Grid.Column="2" Text="{Binding TotalHaberFiltro, StringFormat='{}{0:C0}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource ErpPrimaryText}" HorizontalTextAlignment="End" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
