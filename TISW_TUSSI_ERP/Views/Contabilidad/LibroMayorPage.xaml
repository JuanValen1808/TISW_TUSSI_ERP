<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.LibroMayorPage"
             x:DataType="viewmodels:LibroMayorViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <VerticalStackLayout>
                <Label Text="Libro Mayor" Style="{StaticResource ErpTitle}" />
                <Label Text="Saldos centralizados por cada cuenta contable." Style="{StaticResource ErpSubtitle}" Margin="0,0,0,10" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Calcular Saldos" Command="{Binding CargarSaldosCommand}" Style="{StaticResource ErpPrimaryButton}" VerticalOptions="Center" />
        </Grid>

        <!-- DATA GRID PRINCIPAL -->
        <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="0">
            <RefreshView Command="{Binding CargarSaldosCommand}" IsRefreshing="{Binding EstaOcupado}">
                <ScrollView Orientation="Horizontal">
                    <VerticalStackLayout MinimumWidthRequest="900">

                        <!-- Cabeceras Anidadas -->
                        <Grid ColumnDefinitions="100, *, 120, 120, 120, 120" Padding="15,10" BackgroundColor="#F1F5F9">
                            <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" VerticalOptions="End" />
                            <Label Grid.Column="1" Text="CUENTA CONTABLE" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" VerticalOptions="End" />

                            <Label Grid.Column="2" Grid.ColumnSpan="2" Text="SUMAS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="2" Text="DÉBITOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="3" Text="CRÉDITOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />

                            <Label Grid.Column="4" Grid.ColumnSpan="2" Text="SALDOS" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,15" />
                            <Label Grid.Column="4" Text="DEUDOR" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                            <Label Grid.Column="5" Text="ACREEDOR" Style="{StaticResource ErpSmallLabel}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />

                        <!-- Filas de Datos -->
                        <CollectionView ItemsSource="{Binding SaldosMayores}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LibroMayorItem">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="100, *, 120, 120, 120, 120" Padding="15,12">
                                            <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource ErpSmallLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource ErpLabel}" FontAttributes="Bold" VerticalOptions="Center" />

                                            <Label Grid.Column="2" Text="{Binding TotalDebe, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="3" Text="{Binding TotalHaber, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />

                                            <Label Grid.Column="4" Text="{Binding SaldoDeudor, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                            <Label Grid.Column="5" Text="{Binding SaldoAcreedor, StringFormat='{}{0:N0}'}" Style="{StaticResource ErpLabel}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" Opacity="0.5" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Border>

        <!-- PANEL INFERIOR DE CUADRATURA -->
        <Border Grid.Row="2" Style="{StaticResource ErpCard}" Margin="0,15,0,0" Padding="15" BackgroundColor="#0F172A">
            <ScrollView Orientation="Horizontal">
                <Grid ColumnDefinitions="100, *, 120, 120, 120, 120" MinimumWidthRequest="900">
                    <Label Grid.Column="1" Text="CUADRATURA TOTAL:" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" FontSize="12" />

                    <Label Grid.Column="2" Text="{Binding SumaTotalDebe, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="14" />
                    <Label Grid.Column="3" Text="{Binding SumaTotalHaber, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="14" />
                    <Label Grid.Column="4" Text="{Binding SumaTotalSaldoDeudor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="14" />
                    <Label Grid.Column="5" Text="{Binding SumaTotalSaldoAcreedor, StringFormat='{}{0:N0}'}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" FontSize="14" />
                </Grid>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>