<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.LibroMayorPage"
             x:DataType="viewmodels:LibroMayorViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <StackLayout Grid.Row="0" Padding="20">
            <Label Text="Libro Mayor y Balances" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="Saldos centralizados por cuenta contable (CLP)." FontSize="14" TextColor="Gray" Margin="0,5,0,15" />
            
            <Button Text="Calcular Saldos" 
                    Command="{Binding CargarSaldosCommand}"
                    HorizontalOptions="Start" />
        </StackLayout>

        <RefreshView Grid.Row="1" Command="{Binding CargarSaldosCommand}" IsRefreshing="{Binding EstaOcupado}">
            <!-- ScrollView horizontal para evitar truncamiento en pantallas pequeñas -->
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout Margin="20,0,20,10" MinimumWidthRequest="800">
                    <Grid ColumnDefinitions="150, *, 120, 120, 120, 120" Padding="10,5" BackgroundColor="{StaticResource Primary}">
                        <Label Grid.Column="0" Text="CÓDIGO" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="1" Text="CUENTA" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="2" Text="T. DEBE" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        <Label Grid.Column="3" Text="T. HABER" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        <Label Grid.Column="4" Text="S. DEUDOR" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        <Label Grid.Column="5" Text="S. ACREEDOR" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding SaldosMayores}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LibroMayorItem">
                                <Grid ColumnDefinitions="150, *, 120, 120, 120, 120" Padding="10" BackgroundColor="White">
                                    <Label Grid.Column="0" Text="{Binding CodigoCuenta}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding NombreCuenta}" VerticalOptions="Center" FontAttributes="Bold" />
                                    <Label Grid.Column="2" Text="{Binding TotalDebe, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding TotalHaber, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="4" Text="{Binding SaldoDeudor, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="DarkGreen" />
                                    <Label Grid.Column="5" Text="{Binding SaldoAcreedor, StringFormat='{}{0:N0}'}" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="DarkRed" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Totales de Cuadratura -->
        <Border Grid.Row="2" BackgroundColor="#F8FAFC" Stroke="{StaticResource ErpBorder}" StrokeShape="Rectangle" Padding="20">
            <ScrollView Orientation="Horizontal">
                <Grid ColumnDefinitions="150, *, 120, 120, 120, 120" MinimumWidthRequest="800">
                    <Label Grid.Column="1" Text="TOTALES CUADRATURA:" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <Label Grid.Column="2" Text="{Binding SumaTotalDebe, StringFormat='{}{0:N0}'}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <Label Grid.Column="3" Text="{Binding SumaTotalHaber, StringFormat='{}{0:N0}'}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <Label Grid.Column="4" Text="{Binding SumaTotalSaldoDeudor, StringFormat='{}{0:N0}'}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="DarkGreen" />
                    <Label Grid.Column="5" Text="{Binding SumaTotalSaldoAcreedor, StringFormat='{}{0:N0}'}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="DarkRed" />
                </Grid>
            </ScrollView>
        </Border>

    </Grid>

</ContentPage>
