<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TISW_TUSSI_ERP.ViewModels.Contabilidad"
             xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Contabilidad"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Contabilidad.LibroMayorPage"
             x:DataType="viewmodels:LibroMayorViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource ErpBg}">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Contabilidad › RF-CON-03" Titulo="Libro Mayor y Balances Analíticos" />

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="24" Spacing="18">

                    <!-- HERO BANNER -->
                    <Border Style="{StaticResource CtbHero}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="VISTA ANALÍTICA POR CUENTA CONTABLE · NORMATIVA CHILENA" Style="{StaticResource CtbHeroEyebrow}" />
                                <Label Text="Libro Mayor y Balances de Cuentas" Style="{StaticResource CtbHeroTitle}" />
                                <Label Text="Sumas de Débitos y Créditos acumulados con determinación automática de Saldo Deudor y Saldo Acreedor por cada cuenta imputada."
                                       Style="{StaticResource CtbHeroSubtitle}" />
                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                    <Border Style="{StaticResource CtbHeroChip}">
                                        <Label Text="{Binding EstadoCuadraturaTexto}" Style="{StaticResource CtbHeroChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource CtbHeroChip}">
                                        <Label Text="{Binding GeneradoTexto}" Style="{StaticResource CtbHeroChipText}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                                <Button Text="Calcular Saldos" Command="{Binding CargarSaldosCommand}" Style="{StaticResource CtbHeroButton}" />
                                <Button Text="Exportar PDF" Command="{Binding ExportarPdfCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                                <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}" Style="{StaticResource CtbHeroGhostButton}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- BANNERS -->
                    <Border Style="{StaticResource CtbErrorBanner}" IsVisible="{Binding HayError}">
                        <Label Text="{Binding MensajeError}" TextColor="#991B1B" FontSize="13" FontAttributes="Bold" />
                    </Border>
                    <Border Style="{StaticResource CtbOkBanner}" IsVisible="{Binding HayExito}">
                        <Label Text="{Binding MensajeExito}" TextColor="#065F46" FontSize="13" FontAttributes="Bold" />
                    </Border>

                    <!-- TARJETAS KPI -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#1D6FD8" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="SUMA DÉBITOS (DEBE)" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding SumaTotalDebeTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#1D4ED8" />
                                    <Label Text="Cargos acumulados" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#7C3AED" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="SUMA CRÉDITOS (HABER)" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding SumaTotalHaberTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#6D28D9" />
                                    <Label Text="Abonos acumulados" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#059669" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="TOTAL SALDO DEUDOR" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding SumaTotalSaldoDeudorTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#047857" />
                                    <Label Text="Activos y Pérdidas" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CtbKpiCard}">
                            <Grid ColumnDefinitions="4,*" Padding="16,14" ColumnSpacing="12">
                                <BoxView Style="{StaticResource CtbKpiAccent}" BackgroundColor="#D97706" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="TOTAL SALDO ACREEDOR" Style="{StaticResource CtbKpiLabel}" />
                                    <Label Text="{Binding SumaTotalSaldoAcreedorTexto}" Style="{StaticResource CtbKpiValue}" TextColor="#B45309" />
                                    <Label Text="Pasivos, Patrimonio y Ganancias" Style="{StaticResource CtbKpiHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- BARRA DE FILTROS -->
                    <Border Style="{StaticResource CtbFilterBar}">
                        <Grid ColumnDefinitions="150,150,180,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="DESDE" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="HASTA" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="TIPO DE CUENTA" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <Picker ItemsSource="{Binding TiposFiltro}" SelectedItem="{Binding TipoSeleccionado}" TextColor="#0F172A" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Label Text="BUSCAR CUENTA CONTABLE" Style="{StaticResource CtbFieldLabel}" />
                                <Border Style="{StaticResource CtbField}">
                                    <Entry Placeholder="Buscar por código o nombre de cuenta..."
                                           Text="{Binding Busqueda}"
                                           Style="{StaticResource ErpEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Grid.Column="4"
                                    Text="Aplicar"
                                    Command="{Binding CargarSaldosCommand}"
                                    Style="{StaticResource CtbPrimaryButton}"
                                    VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <!-- TABLA ANALÍTICA DEL LIBRO MAYOR -->
                    <Border Style="{StaticResource CtbTable}">
                        <ScrollView Orientation="Horizontal">
                            <VerticalStackLayout MinimumWidthRequest="1080">

                                <Grid ColumnDefinitions="100,*,120,145,145,145,145,130"
                                      BackgroundColor="#F8FAFC"
                                      Padding="18,12"
                                      ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="CÓDIGO" Style="{StaticResource CtbTh}" />
                                    <Label Grid.Column="1" Text="CUENTA CONTABLE" Style="{StaticResource CtbTh}" />
                                    <Label Grid.Column="2" Text="RUBRO" Style="{StaticResource CtbTh}" />
                                    <Label Grid.Column="3" Text="DÉBITOS (DEBE)" Style="{StaticResource CtbThRight}" />
                                    <Label Grid.Column="4" Text="CRÉDITOS (HABER)" Style="{StaticResource CtbThRight}" />
                                    <Label Grid.Column="5" Text="SALDO DEUDOR" Style="{StaticResource CtbThRight}" />
                                    <Label Grid.Column="6" Text="SALDO ACREEDOR" Style="{StaticResource CtbThRight}" />
                                    <Label Grid.Column="7" Text="FICHA MAYOR" Style="{StaticResource CtbThRight}" />
                                </Grid>
                                <BoxView Style="{StaticResource CtbDivider}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SaldosMayores}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:LibroMayorItem">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="100,*,120,145,145,145,145,130"
                                                      Padding="18,12"
                                                      ColumnSpacing="12">
                                                    <Label Grid.Column="0" Text="{Binding CodigoCuenta}" Style="{StaticResource CtbTdStrong}" />
                                                    <Label Grid.Column="1" Text="{Binding NombreCuenta}" Style="{StaticResource CtbTdStrong}" />

                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource CtbPill}"
                                                            BackgroundColor="{Binding TipoFondo}">
                                                        <Label Text="{Binding TipoCuenta}"
                                                               Style="{StaticResource CtbPillText}"
                                                               TextColor="{Binding TipoColor}" />
                                                    </Border>

                                                    <Label Grid.Column="3" Text="{Binding TotalDebeTexto}" Style="{StaticResource CtbMoney}" />
                                                    <Label Grid.Column="4" Text="{Binding TotalHaberTexto}" Style="{StaticResource CtbMoney}" />
                                                    <Label Grid.Column="5" Text="{Binding SaldoDeudorTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#047857" />
                                                    <Label Grid.Column="6" Text="{Binding SaldoAcreedorTexto}" Style="{StaticResource CtbMoneyStrong}" TextColor="#B45309" />

                                                    <Button Grid.Column="7"
                                                            Text="Ver Mayor"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LibroMayorViewModel}}, Path=VerAnaliticoCuentaCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#EFF6FF"
                                                            TextColor="#1D4ED8"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            CornerRadius="8"
                                                            HeightRequest="30"
                                                            Padding="12,0"
                                                            HorizontalOptions="End" />
                                                </Grid>
                                                <BoxView Style="{StaticResource CtbDivider}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Fila de Cuadratura Final -->
                                <Grid ColumnDefinitions="100,*,120,145,145,145,145,130"
                                      BackgroundColor="#0F172A"
                                      Padding="18,14"
                                      ColumnSpacing="12">
                                    <Label Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="SUMAS IGUALES Y SALDOS DEL MAYOR:"
                                           TextColor="#94A3B8"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding SumaTotalDebeTexto}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="4" Text="{Binding SumaTotalHaberTexto}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="5" Text="{Binding SumaTotalSaldoDeudorTexto}" TextColor="#6EE7B7" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="6" Text="{Binding SumaTotalSaldoAcreedorTexto}" TextColor="#FCD34D" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>

                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- MODAL FICHA ANALÍTICA POR CUENTA (KARDEX MAYOR CONTABLE) -->
            <Grid IsVisible="{Binding MostrarDetalleCuenta}" BackgroundColor="#800F172A">
                <Border WidthRequest="840"
                        MaximumHeightRequest="620"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        Padding="24">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ficha Analítica de Cuenta Mayor (Kardex Contable)" Style="{StaticResource CtbSectionTitle}" FontSize="18" />
                                <Label Text="{Binding CuentaActiva.NombreCuenta}" FontSize="14" FontAttributes="Bold" TextColor="#1D4ED8" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Cerrar" Command="{Binding CerrarAnaliticoCommand}" Style="{StaticResource CtbGhostButton}" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CtbTable}">
                            <ScrollView>
                                <VerticalStackLayout>
                                    <Grid Style="{StaticResource CtbTableHead}" ColumnDefinitions="95,80,95,*,120,120,130">
                                        <Label Grid.Column="0" Text="FECHA" Style="{StaticResource CtbTh}" />
                                        <Label Grid.Column="1" Text="FOLIO" Style="{StaticResource CtbTh}" />
                                        <Label Grid.Column="2" Text="ORIGEN" Style="{StaticResource CtbTh}" />
                                        <Label Grid.Column="3" Text="GLOSA DEL MOVIMIENTO" Style="{StaticResource CtbTh}" />
                                        <Label Grid.Column="4" Text="DEBE" Style="{StaticResource CtbThRight}" />
                                        <Label Grid.Column="5" Text="HABER" Style="{StaticResource CtbThRight}" />
                                        <Label Grid.Column="6" Text="SALDO ACUM." Style="{StaticResource CtbThRight}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource CtbDivider}" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MovimientosCuentaAnalitica}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MayorCentralizadoItem">
                                                <VerticalStackLayout>
                                                    <Grid ColumnDefinitions="95,80,95,*,120,120,130" Padding="16,10" ColumnSpacing="10">
                                                        <Label Grid.Column="0" Text="{Binding FechaTexto}" Style="{StaticResource CtbTd}" />
                                                        <Label Grid.Column="1" Text="{Binding AsientoTexto}" Style="{StaticResource CtbTdStrong}" />
                                                        <Border Grid.Column="2" Style="{StaticResource CtbPill}" BackgroundColor="{Binding OrigenFondo}">
                                                            <Label Text="{Binding Origen}" Style="{StaticResource CtbPillText}" TextColor="{Binding OrigenColor}" />
                                                        </Border>
                                                        <Label Grid.Column="3" Text="{Binding GlosaTexto}" Style="{StaticResource CtbTd}" />
                                                        <Label Grid.Column="4" Text="{Binding DebeTexto}" Style="{StaticResource CtbMoney}" TextColor="#1D4ED8" />
                                                        <Label Grid.Column="5" Text="{Binding HaberTexto}" Style="{StaticResource CtbMoney}" TextColor="#6D28D9" />
                                                        <Label Grid.Column="6" Text="{Binding SaldoAcumuladoTexto}" Style="{StaticResource CtbMoneyStrong}" />
                                                    </Grid>
                                                    <BoxView Style="{StaticResource CtbDivider}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <Label Text="Saldo calculado según la naturaleza contable de la cuenta." Style="{StaticResource CtbTdMuted}" />
                            <Button Grid.Column="1" Text="Entendido" Command="{Binding CerrarAnaliticoCommand}" Style="{StaticResource CtbPrimaryButton}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
