<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
             xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
             xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
             x:Class="TISW_TUSSI_ERP.Views.Ventas.RankingVentasPage"
             x:DataType="vm:RankingVentasViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ErpBg}"
             Title="Ranking de Ventas">

    <Grid RowDefinitions="Auto,*">
        <ctrl:PageHeader Grid.Row="0" Ruta="ERP › Ventas › Reportes" Titulo="Ranking de Ventas" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">

                <Border IsVisible="{Binding HayError}" BackgroundColor="#FEE2E2" Stroke="#FCA5A5" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding MensajeError}" TextColor="#B91C1C" FontSize="12" />
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ventas por cliente y convenio" Style="{StaticResource ErpTitle}" />
                        <Label Text="{Binding CantidadClientesTexto}" Style="{StaticResource ErpSubtitle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="↻  Actualizar" Style="{StaticResource ErpPrimaryButton}"
                            Command="{Binding ComandoActualizar}" VerticalOptions="Center" />
                </Grid>

                <!-- KPIs -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TOTAL VENDIDO (NO ANULADO)" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding TotalGeneralTexto}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ErpCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="DOCUMENTOS CONSIDERADOS" Style="{StaticResource ErpCaption}" />
                            <Label Text="{Binding Filas.Count, StringFormat='{0} filas agrupadas'}" Style="{StaticResource ErpKpi}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tabla del reporte -->
                <Border Style="{StaticResource ErpCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Análisis Pareto de clientes e instituciones" Style="{StaticResource ErpCardTitle}" />
                        <Grid ColumnDefinitions="40,*,110,90,120,90" Padding="0,6">
                            <Label Text="#" Style="{StaticResource ErpCaption}" />
                            <Label Grid.Column="1" Text="CLIENTE" Style="{StaticResource ErpCaption}" />
                            <Label Grid.Column="2" Text="CONVENIO" Style="{StaticResource ErpCaption}" />
                            <Label Grid.Column="3" Text="DOCS." Style="{StaticResource ErpCaption}" />
                            <Label Grid.Column="4" Text="TOTAL" Style="{StaticResource ErpCaption}" />
                            <Label Grid.Column="5" Text="% PART." Style="{StaticResource ErpCaption}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource ErpBorder}" />
                        <CollectionView ItemsSource="{Binding Filas}" MaximumHeightRequest="420">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:FilaRanking">
                                    <Grid ColumnDefinitions="40,*,110,90,120,90" Padding="0,7">
                                        <Label Text="{Binding ., StringFormat='#{0}'}" Style="{StaticResource ErpBody}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="{Binding NombreCliente}" Style="{StaticResource ErpBody}" FontAttributes="Bold" />
                                            <Label Text="{Binding RutCliente}" FontSize="10" TextColor="{StaticResource ErpMuted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding NombreConvenio}" Style="{StaticResource ErpBody}" />
                                        <Label Grid.Column="3" Text="{Binding Documentos}" Style="{StaticResource ErpBody}" />
                                        <Label Grid.Column="4" Text="{Binding TotalTexto}" Style="{StaticResource ErpBody}" />
                                        <Label Grid.Column="5" Text="{Binding PorcentajeTexto}" Style="{StaticResource ErpBody}"
                                               TextColor="{StaticResource ErpPrimary}" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>