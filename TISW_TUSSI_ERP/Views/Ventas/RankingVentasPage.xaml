<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
    xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
    xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.RankingVentasPage"
    x:DataType="vm:RankingVentasViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F7FB"
    Title="Ranking de Ventas">

    <Grid RowDefinitions="Auto,*">

        <ctrl:PageHeader
            Grid.Row="0"
            Ruta="ERP › Ventas › Reportes"
            Titulo="Ranking de Ventas" />

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24"
                Spacing="16">

                <!-- ENCABEZADO -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Ranking de ventas"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Analiza las ventas por cliente y convenio de salud."
                            FontSize="12"
                            TextColor="#64748B" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Actualizar reporte"
                        Command="{Binding ComandoActualizar}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="9"
                        Padding="18,10"
                        VerticalOptions="Center" />

                </Grid>

                <!-- MENSAJE DE ERROR -->
                <Border
                    IsVisible="{Binding HayError}"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 9"
                    Padding="12">

                    <Label
                        Text="{Binding MensajeError}"
                        FontSize="12"
                        TextColor="#B91C1C" />

                </Border>

                <!-- INDICADORES -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="14">

                    <!-- TOTAL VENDIDO -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="TOTAL VENDIDO"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Text="{Binding TotalGeneralTexto}"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Ventas no anuladas"
                                FontSize="11"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- DOCUMENTOS -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="DOCUMENTOS DE VENTA"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Text="{Binding TotalDocumentosTexto}"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Text="Comprobantes registrados"
                                FontSize="11"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- CLIENTES -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="CLIENTES CON VENTAS"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Text="{Binding TotalClientesTexto}"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Text="Incluye Público general"
                                FontSize="11"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- TABLA -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="18">

                    <VerticalStackLayout Spacing="14">

                        <!-- TITULO -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Ventas por cliente y convenio"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D" />

                                <Label
                                    Text="Ordenado por importe total vendido"
                                    FontSize="11"
                                    TextColor="#64748B" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="{Binding TotalFilasTexto}"
                                FontSize="12"
                                TextColor="#64748B"
                                VerticalOptions="Center" />

                        </Grid>

                        <!-- BUSCADOR -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <Entry
                                Text="{Binding Busqueda}"
                                Placeholder="Buscar cliente, RUT o convenio"
                                FontSize="13"
                                TextColor="#172B4D"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="45" />

                            <Button
                                Grid.Column="1"
                                Text="Limpiar"
                                Command="{Binding ComandoLimpiarFiltro}"
                                BackgroundColor="#E8F1FD"
                                TextColor="#2563EB"
                                CornerRadius="8"
                                Padding="18,8" />

                        </Grid>

                        <!-- ENCABEZADOS -->
                        <Grid
                            ColumnDefinitions="2.4*,1.5*,0.6*,1.2*,0.8*"
                            ColumnSpacing="12"
                            BackgroundColor="#F1F5F9"
                            Padding="12,13">

                            <Label
                                Text="CLIENTE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="CONVENIO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="2"
                                Text="DOCS."
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="3"
                                Text="TOTAL VENDIDO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="4"
                                Text="PART."
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                        </Grid>

                        <!-- FILAS -->
                        <CollectionView
                            ItemsSource="{Binding Filas}"
                            SelectionMode="None"
                            MaximumHeightRequest="520">

                            <CollectionView.EmptyView>

                                <VerticalStackLayout
                                    Padding="20"
                                    Spacing="6">

                                    <Label
                                        Text="No hay resultados para mostrar."
                                        FontSize="13"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Actualiza el reporte o modifica la búsqueda."
                                        FontSize="11"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>

                                <DataTemplate x:DataType="m:FilaRanking">

                                    <VerticalStackLayout Spacing="0">

                                        <Grid
                                            ColumnDefinitions="2.4*,1.5*,0.6*,1.2*,0.8*"
                                            ColumnSpacing="12"
                                            Padding="12,15">

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                                    Text="{Binding NombreCliente}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#172B4D"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding RutCliente}"
                                                    FontSize="10"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding NombreConvenio}"
                                                FontSize="12"
                                                TextColor="#475569"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Documentos}"
                                                FontSize="12"
                                                TextColor="#475569"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding TotalTexto}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="4"
                                                Text="{Binding PorcentajeTexto}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#2563EB"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                        </Grid>

                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="#F1F5F9" />

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>

                <!-- EXPLICACION -->
                <Border
                    BackgroundColor="#EFF6FF"
                    Stroke="#DBEAFE"
                    StrokeShape="RoundRectangle 10"
                    Padding="15">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="¿Cómo interpretar el ranking?"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#1D4ED8" />

                        <Label
                            Text="Los clientes se ordenan de mayor a menor según sus ventas. El porcentaje de participación indica cuánto aporta cada fila al total vendido. Un mismo cliente puede aparecer en varias filas si tiene ventas con diferentes convenios."
                            FontSize="12"
                            TextColor="#475569" />

                    </VerticalStackLayout>

                </Border>

                <ActivityIndicator
                    IsRunning="{Binding EstaOcupado}"
                    IsVisible="{Binding EstaOcupado}"
                    Color="#2563EB" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
