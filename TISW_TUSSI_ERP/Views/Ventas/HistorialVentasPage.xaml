<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.HistorialVentasPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ErpBg}"
    Title="Historial de Ventas">

    <Grid RowDefinitions="Auto,*">

        <ctrl:PageHeader
            Grid.Row="0"
            Ruta="ERP › Ventas"
            Titulo="Historial y Monitor de Ventas" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">

                <!-- ENCABEZADO -->
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Historial y Monitor de Ventas"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Label
                        Text="Consulta las ventas registradas y revisa sus productos."
                        FontSize="13"
                        TextColor="#64748B" />
                </VerticalStackLayout>

            <!-- INDICADORES -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="DOCUMENTOS"
                            FontSize="11"
                            TextColor="#64748B" />
                        <Label
                            Text="{Binding CantidadVentas}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#172033" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="VENTAS PAGADAS"
                            FontSize="11"
                            TextColor="#64748B" />
                        <Label
                            Text="{Binding TotalPagadoTexto}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#166534" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="VENTAS PENDIENTES"
                            FontSize="11"
                            TextColor="#64748B" />
                        <Label
                            Text="{Binding TotalPendienteTexto}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#B45309" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- FILTROS -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Buscar y filtrar ventas"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Border Style="{StaticResource ErpInputBox}">
                        <Entry
                            Placeholder="Buscar por folio, cliente o RUT..."
                            Text="{Binding Busqueda}"
                            Style="{StaticResource ErpEntry}" />
                    </Border>

                    <Grid
                        ColumnDefinitions="*,*,Auto,Auto"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            Style="{StaticResource ErpInputBox}">
                            <Picker
                                Title="Estado"
                                ItemsSource="{Binding Estados}"
                                SelectedItem="{Binding EstadoFiltro}"
                                TextColor="#172033"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource ErpInputBox}">
                            <Picker
                                Title="Forma de pago"
                                ItemsSource="{Binding FormasPago}"
                                SelectedItem="{Binding PagoFiltro}"
                                TextColor="#172033"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center" />
                        </Border>

                        <Button
                            Grid.Column="2"
                            Text="Limpiar"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155"
                            Clicked="OnLimpiarClicked" />

                        <Button
                            Grid.Column="3"
                            Text="Actualizar"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            Clicked="OnActualizarClicked" />

                    </Grid>

                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="12"
                        TextColor="#DC2626" />

                </VerticalStackLayout>
            </Border>

            <!-- LISTADO -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Ventas registradas"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#172033" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding TotalVentasTexto}"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />
                    </Grid>

                    <CollectionView
                        x:Name="ListaVentasHistorial"
                        ItemsSource="{Binding Ventas}"
                        SelectionMode="Single"
                        SelectionChanged="OnVentaSeleccionada"
                        HeightRequest="340">

                        <CollectionView.EmptyView>
                            <Label
                                Text="No se encontraron ventas."
                                Padding="12"
                                TextColor="#64748B" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F8FAFC"
                                    Padding="12"
                                    Margin="0,0,0,8">

                                    <Grid
                                        ColumnDefinitions="2*,2*,*,*,Auto"
                                        ColumnSpacing="10">

                                        <VerticalStackLayout Grid.Column="0">
                                            <Label
                                                Text="{Binding Folio}"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                TextColor="#172033"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding FechaTexto}"
                                                FontSize="11"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1">
                                            <Label
                                                Text="{Binding Cliente}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172033"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding RutCliente}"
                                                FontSize="11"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2">
                                            <Label
                                                Text="{Binding Estado}"
                                                FontSize="11"
                                                TextColor="#172033" />
                                            <Label
                                                Text="{Binding FormaPago}"
                                                FontSize="10"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="3"
                                            Text="{Binding TotalTexto}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#172033"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="4"
                                            Text="Ver detalle ›"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#2563EB"
                                            VerticalOptions="Center" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- DETALLE -->
            <Border
                IsVisible="{Binding HayDetalle}"
                BackgroundColor="White"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 12"
                Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Detalle de la venta"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#172033" />

                        <Button
                            Grid.Column="1"
                            Text="Cerrar"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155"
                            Clicked="OnCerrarDetalleClicked" />
                    </Grid>

                    <Label
                        Text="{Binding VentaSeleccionada.Folio}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding VentaSeleccionada.Cliente}"
                        FontSize="13"
                        TextColor="#334155" />

                    <Label
                        Text="{Binding VentaSeleccionada.FechaTexto}"
                        FontSize="12"
                        TextColor="#64748B" />

                    <Label
                        Text="Productos vendidos"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Detalles}"
                        Spacing="8">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                Text="{Binding Producto}"
                                                FontAttributes="Bold"
                                                TextColor="#172033" />

                                            <Label
                                                Text="{Binding Sku, StringFormat='SKU: {0}'}"
                                                FontSize="11"
                                                TextColor="#64748B" />

                                            <Label
                                                Text="{Binding Lote, StringFormat='Lote: {0}'}"
                                                FontSize="11"
                                                TextColor="#64748B" />

                                            <Label
                                                Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}"
                                                FontSize="11"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Spacing="4">
                                            <Label
                                                Text="{Binding PrecioTexto}"
                                                FontSize="12"
                                                TextColor="#64748B" />
                                            <Label
                                                Text="{Binding SubtotalTexto}"
                                                FontAttributes="Bold"
                                                TextColor="#172033" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                        <Label Text="Neto" TextColor="#64748B" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding VentaSeleccionada.NetoTexto}"
                            TextColor="#172033" />

                        <Label
                            Grid.Row="1"
                            Text="IVA"
                            TextColor="#64748B" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding VentaSeleccionada.IvaTexto}"
                            TextColor="#172033" />

                        <Label
                            Grid.Row="2"
                            Text="Descuento"
                            TextColor="#64748B" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding VentaSeleccionada.DescuentoTexto}"
                            TextColor="#172033" />

                        <Label
                            Grid.Row="3"
                            Text="TOTAL"
                            FontAttributes="Bold"
                            TextColor="#172033" />
                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding VentaSeleccionada.TotalTexto}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
