<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
    xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
    xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.PosPage"
    x:Name="PaginaPos"
    x:DataType="vm:PosViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ErpBg}"
    Title="Punto de Venta">

    <Grid RowDefinitions="Auto,*">

        <ctrl:PageHeader
            Grid.Row="0"
            Ruta="ERP › Ventas"
            Titulo="Punto de Venta" />

        <Grid
            Grid.Row="1"
            Padding="14"
            ColumnDefinitions="*,325"
            ColumnSpacing="12">

            <!-- COLUMNA IZQUIERDA: BÚSQUEDA COMPACTA ARRIBA + GRAN TABLA DE CARRITO ABAJO -->
            <Grid
                Grid.Column="0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="10"
                IsClippedToBounds="True">

                <!-- ALERTAS DE ESTADO -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Spacing="6">

                    <Border
                        IsVisible="{Binding CajaCerrada}"
                        BackgroundColor="#FEF3C7"
                        Stroke="#FCD34D"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">

                        <Label
                            Text="Caja cerrada: abre un turno en Control de Caja antes de vender con cualquier forma de pago."
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#92400E" />
                    </Border>

                    <Border
                        IsVisible="{Binding HayError}"
                        BackgroundColor="#FEE2E2"
                        Stroke="#FCA5A5"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">

                        <Label
                            Text="{Binding MensajeError}"
                            FontSize="12"
                            TextColor="#B91C1C" />
                    </Border>

                    <Border
                        IsVisible="{Binding HayOk}"
                        BackgroundColor="#DCFCE7"
                        Stroke="#86EFAC"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">

                        <Label
                            Text="{Binding MensajeOk}"
                            FontSize="12"
                            TextColor="#166534" />
                    </Border>
                </VerticalStackLayout>

                <!-- BLOQUE COMPACTO DE BÚSQUEDA / CATÁLOGO / SELECCIÓN DE LOTE -->
                <Border
                    Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">

                    <Grid
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8">

                        <!-- Fila única: Buscador + Escáner + Botón plegar catálogo -->
                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="1.35*,74,1*,80,Auto"
                            ColumnSpacing="6">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 7"
                                Padding="10,0"
                                HeightRequest="34">

                                <Entry
                                    Text="{Binding BusquedaProducto}"
                                    Placeholder="Buscar medicamento o SKU..."
                                    FontSize="12"
                                    TextColor="#172B4D"
                                    PlaceholderColor="#94A3B8"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HeightRequest="32"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center"
                                    ReturnCommand="{Binding ComandoBuscarCatalogo}" />
                            </Border>

                            <Button
                                Grid.Column="1"
                                Text="Buscar"
                                FontSize="12"
                                FontAttributes="Bold"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                HeightRequest="34"
                                Padding="0"
                                CornerRadius="7"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                VerticalOptions="Center"
                                Command="{Binding ComandoBuscarCatalogo}" />

                            <Border
                                Grid.Column="2"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 7"
                                Padding="10,0"
                                HeightRequest="34">

                                <Entry
                                    Text="{Binding CodigoBuscado}"
                                    Placeholder="Escanear código / SKU"
                                    FontSize="12"
                                    TextColor="#172B4D"
                                    PlaceholderColor="#94A3B8"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HeightRequest="32"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center"
                                    ReturnCommand="{Binding ComandoBuscar}" />
                            </Border>

                            <Button
                                Grid.Column="3"
                                Text="Escanear"
                                FontSize="11"
                                FontAttributes="Bold"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                HeightRequest="34"
                                Padding="0"
                                CornerRadius="7"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                VerticalOptions="Center"
                                Command="{Binding ComandoBuscar}" />

                            <Button
                                Grid.Column="4"
                                Text="{Binding TextoBotonCatalogo}"
                                FontSize="11"
                                FontAttributes="Bold"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                HeightRequest="34"
                                Padding="12,0"
                                CornerRadius="7"
                                BackgroundColor="#F1F5F9"
                                TextColor="#334155"
                                VerticalOptions="Center"
                                Command="{Binding ComandoAlternarCatalogo}" />
                        </Grid>

                        <!-- Sub-vista A: Lista compacta de catálogo (~4 filas visibles bien proporcionadas) -->
                        <Border
                            Grid.Row="1"
                            IsVisible="{Binding MostrarListaCatalogo}"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 8"
                            Padding="0">

                            <Grid RowDefinitions="Auto,132">

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="78,2*,1.2*,84,78"
                                    ColumnSpacing="8"
                                    Padding="10,6"
                                    BackgroundColor="#F1F5F9">

                                    <Label
                                        Text="SKU"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#64748B" />

                                    <Label
                                        Grid.Column="1"
                                        Text="PRODUCTO DISPONIBLE"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#64748B" />

                                    <Label
                                        Grid.Column="2"
                                        Text="PRINCIPIO ACTIVO"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#64748B" />

                                    <Label
                                        Grid.Column="3"
                                        Text="PRECIO"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Grid.Column="4"
                                        Text="ACCIÓN"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />
                                </Grid>

                                <CollectionView
                                    Grid.Row="1"
                                    ItemsSource="{Binding Productos}"
                                    SelectionMode="None">

                                    <CollectionView.EmptyView>
                                        <Label
                                            Text="No se encontraron productos disponibles."
                                            TextColor="#64748B"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </CollectionView.EmptyView>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="m:ProductoPos">
                                            <Grid RowDefinitions="Auto,1">
                                                <Grid
                                                    ColumnDefinitions="78,2*,1.2*,84,78"
                                                    ColumnSpacing="8"
                                                    Padding="10,4">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="{Binding Sku}"
                                                        FontSize="11"
                                                        TextColor="#475569"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding NombreComercial}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#172B4D"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding PrincipioActivo}"
                                                        FontSize="11"
                                                        TextColor="#64748B"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="3"
                                                        Text="{Binding PrecioTexto}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#172B4D"
                                                        HorizontalTextAlignment="End"
                                                        VerticalOptions="Center" />

                                                    <Button
                                                        Grid.Column="4"
                                                        Text="+ Elegir"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        MinimumHeightRequest="0"
                                                        MinimumWidthRequest="0"
                                                        HeightRequest="25"
                                                        Padding="8,0"
                                                        CornerRadius="6"
                                                        BackgroundColor="#DBEAFE"
                                                        TextColor="#1D4ED8"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Center"
                                                        Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoSeleccionarProducto, x:DataType={x:Null}}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid>

                                                <BoxView
                                                    Grid.Row="1"
                                                    HeightRequest="1"
                                                    Color="#F1F5F9" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </Grid>
                        </Border>

                        <!-- Sub-vista B: Selección limpia de Lote FEFO cuando se elige un producto -->
                        <Border
                            Grid.Row="1"
                            IsVisible="{Binding HayProducto}"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8">

                            <Grid
                                ColumnDefinitions="1.15*,1.65*,60,106,72"
                                ColumnSpacing="8">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Producto.NombreComercial}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#172B4D"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding Producto.PrecioTexto, StringFormat='Precio unit.: {0}'}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#2563EB" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="White"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="8,2"
                                    MinimumHeightRequest="36"
                                    VerticalOptions="Center">

                                    <Picker
                                        ItemsSource="{Binding Lotes}"
                                        SelectedItem="{Binding LoteSeleccionado, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding Descripcion}"
                                        TextColor="#172B4D"
                                        FontSize="12"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    BackgroundColor="White"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="4,0"
                                    HeightRequest="36"
                                    VerticalOptions="Center">

                                    <Entry
                                        Text="{Binding CantidadTexto}"
                                        Keyboard="Numeric"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#172B4D"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        HeightRequest="34"
                                        HorizontalOptions="Fill"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <Button
                                    Grid.Column="3"
                                    Text="+ Al carrito"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HeightRequest="36"
                                    Padding="0"
                                    CornerRadius="7"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    Command="{Binding ComandoAgregar}" />

                                <Button
                                    Grid.Column="4"
                                    Text="Volver"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HeightRequest="36"
                                    Padding="0"
                                    CornerRadius="7"
                                    BackgroundColor="White"
                                    TextColor="#475569"
                                    VerticalOptions="Center"
                                    Command="{Binding ComandoCancelarSeleccionProducto}" />
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- PROTAGONISTA PRINCIPAL: GRAN TABLA DEL CARRITO DE PRODUCTOS -->
                <Border
                    Grid.Row="2"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,12">

                    <Grid
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="8">

                        <!-- Encabezado del carrito -->
                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="Auto,Auto,*,Auto"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="Carrito de productos"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#172B4D"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,3"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding ResumenCarritoTexto}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#1D4ED8" />
                            </Border>

                            <Button
                                Grid.Column="3"
                                Text="Vaciar carrito"
                                IsVisible="{Binding HayItems}"
                                FontSize="11"
                                FontAttributes="Bold"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                HeightRequest="28"
                                Padding="12,0"
                                CornerRadius="6"
                                BackgroundColor="#FEE2E2"
                                TextColor="#DC2626"
                                VerticalOptions="Center"
                                Command="{Binding ComandoLimpiar}" />
                        </Grid>

                        <!-- Cabecera de tabla proporcional -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="76,2.3*,1.1*,84,104,90,32"
                            ColumnSpacing="8"
                            Padding="10,7"
                            BackgroundColor="#F1F5F9">

                            <Label
                                Grid.Column="0"
                                Text="SKU"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="MEDICAMENTO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="2"
                                Text="LOTE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="3"
                                Text="P. UNIT."
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="4"
                                Text="CANTIDAD"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="5"
                                Text="SUBTOTAL"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="6"
                                Text=""
                                FontSize="10" />
                        </Grid>

                        <!-- Filas compactas del carrito -->
                        <CollectionView
                            Grid.Row="2"
                            ItemsSource="{Binding Carrito}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Spacing="4"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Margin="0,30">

                                    <Label
                                        Text="Tu carrito está vacío."
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Selecciona o escanea medicamentos arriba para verlos listados aquí."
                                        FontSize="12"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ItemCarrito">
                                    <Grid RowDefinitions="Auto,1">
                                        <Grid
                                            ColumnDefinitions="76,2.3*,1.1*,84,104,90,32"
                                            ColumnSpacing="8"
                                            Padding="10,5">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Sku}"
                                                FontSize="11"
                                                TextColor="#475569"
                                                LineBreakMode="TailTruncation"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding NombreProducto}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                LineBreakMode="TailTruncation"
                                                VerticalOptions="Center" />

                                            <Border
                                                Grid.Column="2"
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="7,3"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding NumeroLote}"
                                                    FontSize="11"
                                                    TextColor="#475569"
                                                    LineBreakMode="TailTruncation" />
                                            </Border>

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding PrecioUnitarioTexto}"
                                                FontSize="12"
                                                TextColor="#475569"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                            <!-- Controles cuadrados exactos 26x26 alineados al centro -->
                                            <HorizontalStackLayout
                                                Grid.Column="4"
                                                Spacing="4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">

                                                <Button
                                                    Text="−"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    Padding="0"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    CornerRadius="6"
                                                    BackgroundColor="#E2E8F0"
                                                    TextColor="#334155"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoReducirCantidad, x:DataType={x:Null}}"
                                                    CommandParameter="{Binding .}" />

                                                <Border
                                                    BackgroundColor="#F8FAFC"
                                                    Stroke="#E2E8F0"
                                                    StrokeShape="RoundRectangle 6"
                                                    MinimumWidthRequest="36"
                                                    HeightRequest="26"
                                                    Padding="6,0"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Cantidad}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#172B4D"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </Border>

                                                <Button
                                                    Text="+"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    Padding="0"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    CornerRadius="6"
                                                    BackgroundColor="#DBEAFE"
                                                    TextColor="#1D4ED8"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoAumentarCantidad, x:DataType={x:Null}}"
                                                    CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>

                                            <Label
                                                Grid.Column="5"
                                                Text="{Binding SubtotalTexto}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                            <Button
                                                Grid.Column="6"
                                                Text="✕"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                Padding="0"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                CornerRadius="6"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoQuitar, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>

                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="1"
                                            Color="#F1F5F9" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </Border>

            </Grid>

            <!-- COLUMNA DERECHA: FLUJO CONTINUO SIN HUECO INTERMEDIO -->
            <Border
                Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="11">

                        <!-- Encabezado -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label
                                    Text="Venta actual"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D" />

                                <Label
                                    Text="Cliente, convenio y cobro"
                                    FontSize="11"
                                    TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Limpiar"
                                FontSize="11"
                                FontAttributes="Bold"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                HeightRequest="28"
                                Padding="12,0"
                                CornerRadius="6"
                                BackgroundColor="#F1F5F9"
                                TextColor="#475569"
                                VerticalOptions="Center"
                                Command="{Binding ComandoLimpiar}" />
                        </Grid>

                        <!-- Tarjeta Cliente Actual -->
                        <Border
                            BackgroundColor="#EFF6FF"
                            Stroke="#DBEAFE"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,10">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label
                                        Text="CLIENTE"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="#64748B" />

                                    <Label
                                        Text="{Binding NombreClienteActual}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#1D4ED8"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Público gral."
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HeightRequest="26"
                                    Padding="8,0"
                                    CornerRadius="6"
                                    BackgroundColor="White"
                                    TextColor="#2563EB"
                                    VerticalOptions="Center"
                                    Command="{Binding ComandoPublicoGeneral}" />
                            </Grid>
                        </Border>

                        <!-- Selector de Cliente Registrado -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Cliente registrado (opcional)"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 7"
                                Padding="8,2"
                                MinimumHeightRequest="41">

                                <Picker
                                    Title="Seleccionar cliente..."
                                    ItemsSource="{Binding Clientes}"
                                    SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    FontSize="12"
                                    TextColor="#172B4D"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Aviso informativo cuando es Público general -->
                        <Border
                            IsVisible="{Binding EsPublicoGeneral}"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,10">

                            <Label
                                Text="Elige un cliente registrado para aplicar descuento por convenio o vender a crédito."
                                FontSize="11"
                                TextColor="#64748B" />
                        </Border>

                        <!-- Convenio + % de descuento automático cuando hay cliente seleccionado -->
                        <VerticalStackLayout
                            Spacing="4"
                            IsVisible="{Binding TieneClienteSeleccionado}">

                            <Label
                                Text="Convenio de salud (descuento / crédito)"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="8,2"
                                    MinimumHeightRequest="41">

                                    <Picker
                                        Title="Sin convenio..."
                                        ItemsSource="{Binding Convenios}"
                                        SelectedItem="{Binding ConvenioSeleccionado, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding NombreConvenio}"
                                        FontSize="12"
                                        TextColor="#172B4D"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="#DCFCE7"
                                    Stroke="#BBF7D0"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="10,0"
                                    MinimumHeightRequest="41">

                                    <Label
                                        Text="{Binding PorcentajeDescuentoTexto}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#166534"
                                        VerticalOptions="Center" />
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Text="✕"
                                    IsVisible="{Binding TieneConvenioSeleccionado}"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    WidthRequest="34"
                                    HeightRequest="41"
                                    Padding="0"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="7"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    VerticalOptions="Center"
                                    Command="{Binding ComandoQuitarConvenio}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Separador limpio de sección (reemplaza el vacío intermedio) -->
                        <BoxView
                            HeightRequest="1"
                            Color="#E2E8F0"
                            Margin="0,2" />

                        <Label
                            Text="RESUMEN Y PAGO"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <!-- Tarjeta agrupada de desglose tributario -->
                        <Border
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 8"
                            Padding="13,11">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="7">

                                <Label
                                    Text="Ítems / Unidades"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ResumenCarritoTexto}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#334155" />

                                <Label
                                    Grid.Row="1"
                                    Text="Subtotal"
                                    FontSize="12"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding SubtotalTexto}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D" />

                                <Label
                                    Grid.Row="2"
                                    Text="{Binding EtiquetaDescuento}"
                                    FontSize="12"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding DescuentoTexto}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#16A34A" />

                                <Label
                                    Grid.Row="3"
                                    Text="Neto"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding NetoTexto}"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="4"
                                    Text="IVA incluido (19%)"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding IvaTexto}"
                                    FontSize="11"
                                    TextColor="#64748B" />
                            </Grid>
                        </Border>

                        <!-- Total destacado -->
                        <Border
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,12">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="TOTAL A PAGAR"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding TotalTexto}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#2563EB"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Forma de pago -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Forma de pago"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 7"
                                Padding="8,2"
                                MinimumHeightRequest="41">

                                <Picker
                                    ItemsSource="{Binding FormasPago}"
                                    SelectedItem="{Binding FormaPagoSeleccionada, Mode=TwoWay}"
                                    FontSize="12"
                                    TextColor="#172B4D"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Botón Cobrar -->
                        <Button
                            Text="Cobrar / Emitir venta"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="8"
                            MinimumHeightRequest="0"
                            HeightRequest="45"
                            Margin="0,2,0,0"
                            IsEnabled="{Binding HayItems}"
                            Command="{Binding ComandoEmitir}" />

                        <ActivityIndicator
                            IsVisible="{Binding EstaOcupado}"
                            IsRunning="{Binding EstaOcupado}"
                            Color="#2563EB"
                            HeightRequest="16" />

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
