<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
    xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
    xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.PosPage"
    x:Name="PaginaPos"
    x:DataType="vm:PosViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ErpBg}"
    Title="Punto de Venta">

    <Grid RowDefinitions="Auto,*">

        <ctrl:PageHeader
            Grid.Row="0"
            Ruta="ERP › Ventas"
            Titulo="Punto de Venta" />

        <Grid
            Grid.Row="1"
            Padding="16"
            ColumnDefinitions="*,370"
            ColumnSpacing="14">

            <!-- PRODUCTOS -->
            <Grid
                Grid.Column="0"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="10">

                <!-- MENSAJES -->
                <VerticalStackLayout Spacing="6">

                    <Border
                        IsVisible="{Binding HayError}"
                        BackgroundColor="#FEE2E2"
                        Stroke="#FCA5A5"
                        StrokeShape="RoundRectangle 8"
                        Padding="10">

                        <Label
                            Text="{Binding MensajeError}"
                            FontSize="12"
                            TextColor="#B91C1C" />
                    </Border>

                    <Border
                        IsVisible="{Binding HayOk}"
                        BackgroundColor="#DCFCE7"
                        Stroke="#86EFAC"
                        StrokeShape="RoundRectangle 8"
                        Padding="10">

                        <Label
                            Text="{Binding MensajeOk}"
                            FontSize="12"
                            TextColor="#166534" />
                    </Border>
                </VerticalStackLayout>

                <!-- BUSCADOR -->
                <Border
                    Grid.Row="1"
                    Style="{StaticResource ErpCard}">

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="Buscar productos"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Grid
                            ColumnDefinitions="*,90"
                            ColumnSpacing="8">

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 7"
                                Padding="8,0">

                                <Entry
                                    Text="{Binding BusquedaProducto}"
                                    Placeholder="Nombre, SKU o código de barras"
                                    FontSize="13"
                                    TextColor="#172B4D"
                                    PlaceholderColor="#94A3B8"
                                    BackgroundColor="Transparent"
                                    HeightRequest="36"
                                    ReturnCommand="{Binding ComandoBuscarCatalogo}" />
                            </Border>

                            <Button
                                Grid.Column="1"
                                Text="Buscar"
                                FontSize="12"
                                CornerRadius="7"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                Command="{Binding ComandoBuscarCatalogo}" />
                        </Grid>

                        <Grid
                            ColumnDefinitions="*,90"
                            ColumnSpacing="8">

                            <Border
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 7"
                                Padding="8,0">

                                <Entry
                                    Text="{Binding CodigoBuscado}"
                                    Placeholder="Escanear SKU / código"
                                    FontSize="12"
                                    TextColor="#172B4D"
                                    PlaceholderColor="#94A3B8"
                                    BackgroundColor="Transparent"
                                    HeightRequest="34"
                                    ReturnCommand="{Binding ComandoBuscar}" />
                            </Border>

                            <Button
                                Grid.Column="1"
                                Text="Escanear"
                                FontSize="11"
                                CornerRadius="7"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                Command="{Binding ComandoBuscar}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- CATALOGO -->
                <Border
                    Grid.Row="2"
                    Style="{StaticResource ErpCard}">

                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Productos disponibles"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Productos.Count, StringFormat='{0} productos'}"
                                FontSize="11"
                                TextColor="#64748B" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,90,85,75"
                            ColumnSpacing="7"
                            Padding="8"
                            BackgroundColor="#F1F5F9">

                            <Label
                                Text="PRODUCTO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="SKU"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="2"
                                Text="PRECIO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="3"
                                Text="ACCIÓN"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />
                        </Grid>

                        <CollectionView
                            Grid.Row="2"
                            ItemsSource="{Binding Productos}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <Label
                                    Text="No hay productos disponibles."
                                    TextColor="#64748B"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,25" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductoPos">

                                    <Grid
                                        ColumnDefinitions="*,90,85,75"
                                        ColumnSpacing="7"
                                        Padding="8,10">

                                        <VerticalStackLayout Spacing="2">

                                            <Label
                                                Text="{Binding NombreComercial}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Text="{Binding PrincipioActivo}"
                                                FontSize="10"
                                                TextColor="#94A3B8" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Sku}"
                                            FontSize="11"
                                            TextColor="#475569"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding PrecioTexto}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#172B4D"
                                            VerticalOptions="Center" />

                                        <Button
                                            Grid.Column="3"
                                            Text="+ Añadir"
                                            FontSize="10"
                                            Padding="5,3"
                                            CornerRadius="6"
                                            BackgroundColor="#DBEAFE"
                                            TextColor="#1D4ED8"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoSeleccionarProducto, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </Border>

                <!-- PRODUCTO SELECCIONADO -->
                <Border
                    Grid.Row="3"
                    IsVisible="{Binding HayProducto}"
                    Style="{StaticResource ErpCard}">

                    <VerticalStackLayout Spacing="9">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Producto seleccionado"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Producto.PrecioTexto}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />
                        </Grid>

                        <Label
                            Text="{Binding Producto.NombreComercial}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Grid
                            ColumnDefinitions="*,75,135"
                            ColumnSpacing="8">

                            <Picker
                                ItemsSource="{Binding Lotes}"
                                SelectedItem="{Binding LoteSeleccionado, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding Descripcion}"
                                Title="Lote FEFO"
                                TextColor="#172B4D"
                                TitleColor="#64748B"
                                FontSize="12"
                                BackgroundColor="#F8FAFC" />

                            <Entry
                                Grid.Column="1"
                                Text="{Binding CantidadTexto}"
                                Keyboard="Numeric"
                                FontSize="13"
                                TextColor="#172B4D"
                                HorizontalTextAlignment="Center"
                                BackgroundColor="#F8FAFC" />

                            <Button
                                Grid.Column="2"
                                Text="Agregar al carrito"
                                FontSize="11"
                                CornerRadius="7"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                Command="{Binding ComandoAgregar}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- PANEL DE VENTA -->
            <Border
                Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12"
                Padding="14">

                <Grid
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="10">

                    <!-- ENCABEZADO -->
                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Venta actual"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Text="Nueva venta"
                                FontSize="11"
                                TextColor="#94A3B8" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Limpiar"
                            FontSize="11"
                            Padding="12,5"
                            CornerRadius="6"
                            BackgroundColor="#F1F5F9"
                            TextColor="#475569"
                            Command="{Binding ComandoLimpiar}" />
                    </Grid>

                    <!-- CLIENTE Y DESCUENTO -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="7">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            BackgroundColor="#EFF6FF"
                            Padding="10,8">

                            <VerticalStackLayout Spacing="2">

                                <Label
                                    Text="CLIENTE"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Label
                                    Text="{Binding NombreClienteActual}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#1D4ED8"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Público general"
                                FontSize="10"
                                Padding="8,4"
                                CornerRadius="6"
                                BackgroundColor="White"
                                TextColor="#2563EB"
                                Command="{Binding ComandoPublicoGeneral}" />
                        </Grid>

                        <Picker
                            Title="Seleccionar cliente registrado (opcional)"
                            ItemsSource="{Binding Clientes}"
                            SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Nombre}"
                            FontSize="12"
                            TextColor="#172B4D"
                            TitleColor="#64748B"
                            BackgroundColor="#F8FAFC" />

                        <Picker
                            Title="Convenio (opcional)"
                            ItemsSource="{Binding Convenios}"
                            SelectedItem="{Binding ConvenioSeleccionado, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding NombreConvenio}"
                            FontSize="12"
                            TextColor="#172B4D"
                            TitleColor="#64748B"
                            BackgroundColor="#F8FAFC" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">

                            <Picker
                                ItemsSource="{Binding TiposDescuento}"
                                SelectedItem="{Binding TipoDescuentoSeleccionado, Mode=TwoWay}"
                                FontSize="12"
                                TextColor="#172B4D"
                                TitleColor="#64748B"
                                BackgroundColor="#F8FAFC" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding PorcentajeDescuentoTexto}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#16A34A"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>

                    <!-- CARRITO CON BOTONES + Y - -->
                    <Grid
                        Grid.Row="2"
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Carrito"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Carrito.Count, StringFormat='{0} productos'}"
                                FontSize="11"
                                TextColor="#64748B" />
                        </Grid>

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding Carrito}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <Label
                                    Text="Tu carrito está vacío."
                                    FontSize="12"
                                    TextColor="#94A3B8"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,20" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ItemCarrito">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="8"
                                        RowSpacing="8"
                                        Padding="4,12">

                                        <VerticalStackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="3">

                                            <Label
                                                Text="{Binding NombreProducto}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Text="{Binding NumeroLote, StringFormat='Lote: {0}'}"
                                                FontSize="10"
                                                TextColor="#94A3B8" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding SubtotalTexto}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#172B4D"
                                            VerticalOptions="Center" />

                                        <!-- BOTONES DE CANTIDAD -->
                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="5">

                                            <Button
                                                Text="−"
                                                WidthRequest="34"
                                                HeightRequest="32"
                                                Padding="0"
                                                FontSize="17"
                                                CornerRadius="6"
                                                BackgroundColor="#E2E8F0"
                                                TextColor="#334155"
                                                Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoReducirCantidad, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />

                                            <Border
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 6"
                                                WidthRequest="45"
                                                HeightRequest="32">

                                                <Label
                                                    Text="{Binding Cantidad}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="#172B4D"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <Button
                                                Text="+"
                                                WidthRequest="34"
                                                HeightRequest="32"
                                                Padding="0"
                                                FontSize="17"
                                                CornerRadius="6"
                                                BackgroundColor="#DBEAFE"
                                                TextColor="#1D4ED8"
                                                Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoAumentarCantidad, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />

                                        </HorizontalStackLayout>

                                        <!-- ELIMINAR -->
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="Eliminar"
                                            FontSize="10"
                                            Padding="10,4"
                                            CornerRadius="6"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            Command="{Binding Source={x:Reference PaginaPos}, Path=BindingContext.ComandoQuitar, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>

                    <!-- RESUMEN Y COBRO -->
                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="8">

                        <BoxView
                            HeightRequest="1"
                            Color="#E2E8F0" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="5">

                            <Label
                                Text="Subtotal"
                                FontSize="12"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding SubtotalTexto}"
                                FontSize="12"
                                TextColor="#172B4D" />

                            <Label
                                Grid.Row="1"
                                Text="Descuento"
                                FontSize="12"
                                TextColor="#64748B" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding DescuentoTexto}"
                                FontSize="12"
                                TextColor="#16A34A" />

                            <Label
                                Grid.Row="2"
                                Text="Neto"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding NetoTexto}"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                Grid.Row="3"
                                Text="IVA incluido (19%)"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding IvaTexto}"
                                FontSize="11"
                                TextColor="#64748B" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#E2E8F0" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="TOTAL A PAGAR"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#172B4D"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding TotalTexto}"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />
                        </Grid>

                        <Picker
                            Title="Forma de pago"
                            ItemsSource="{Binding FormasPago}"
                            SelectedItem="{Binding FormaPagoSeleccionada, Mode=TwoWay}"
                            FontSize="12"
                            TextColor="#172B4D"
                            TitleColor="#64748B"
                            BackgroundColor="#F8FAFC" />

                        <Button
                            Text="Cobrar / Emitir venta"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="44"
                            IsEnabled="{Binding HayItems}"
                            Command="{Binding ComandoEmitir}" />

                        <ActivityIndicator
                            IsVisible="{Binding EstaOcupado}"
                            IsRunning="{Binding EstaOcupado}"
                            Color="#2563EB"
                            HeightRequest="18" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
