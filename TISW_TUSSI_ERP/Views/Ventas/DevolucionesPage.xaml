<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
    xmlns:models="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.DevolucionesPage"
    x:DataType="vm:DevolucionesViewModel"
    Title="Devoluciones de Ventas"
    BackgroundColor="#F5F7FB"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <!-- ENCABEZADO -->

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="ERP / Ventas / Devoluciones"
                    FontSize="12"
                    TextColor="#64748B" />

                <Label
                    Text="Devoluciones de Ventas"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />

                <Label
                    Text="Selecciona una venta y registra los productos devueltos."
                    FontSize="14"
                    TextColor="#64748B" />

            </VerticalStackLayout>

            <!-- NUEVO: SELECTOR DE VENTAS -->

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Seleccionar venta registrada"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="Busca por folio, nombre del cliente o RUT. Solo aparecen ventas pagadas con unidades disponibles para devolución."
                        FontSize="13"
                        TextColor="#64748B" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                        <Entry
                            x:Name="BusquedaVentas"
                            Grid.Column="0"
                            Placeholder="Buscar folio, cliente o RUT..."
                            Completed="OnBusquedaVentasCompleted"
                            TextColor="#0F172A"
                            PlaceholderColor="#64748B"
                            BackgroundColor="#F8FAFC"
                            HeightRequest="48"
                            FontSize="14" />

                        <Button
                            Grid.Column="1"
                            Text="Buscar / Actualizar"
                            Clicked="OnBuscarVentasClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            Padding="18,10" />

                    </Grid>

                    <ActivityIndicator
                        x:Name="CargandoVentas"
                        IsRunning="False"
                        IsVisible="False"
                        Color="#2563EB" />

                    <Label
                        x:Name="MensajeSelector"
                        FontSize="12"
                        TextColor="#64748B" />

                    <CollectionView
                        x:Name="ListaVentas"
                        HeightRequest="280"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:VentaParaDevolucion">

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,8">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="4">

                                            <Label
                                                Text="{Binding Cliente}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A" />

                                            <Label
                                                Text="{Binding Folio}"
                                                FontSize="12"
                                                TextColor="#2563EB"
                                                LineBreakMode="TailTruncation" />

                                            <HorizontalStackLayout
                                                Spacing="12">

                                                <Label
                                                    Text="{Binding FechaTexto}"
                                                    FontSize="11"
                                                    TextColor="#64748B" />

                                                <Label
                                                    Text="{Binding RutTexto}"
                                                    FontSize="11"
                                                    TextColor="#64748B" />

                                            </HorizontalStackLayout>

                                            <Label
                                                Text="{Binding TotalTexto}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A" />

                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="1"
                                            Text="Seleccionar"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnSeleccionarVentaClicked"
                                            BackgroundColor="#E8F1FD"
                                            TextColor="#1D6FD8"
                                            VerticalOptions="Center"
                                            Padding="14,10"
                                            FontSize="12" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Border>

            <!-- BÚSQUEDA MANUAL -->

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Buscar venta por folio"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="También puedes ingresar manualmente el folio de una venta."
                        FontSize="13"
                        TextColor="#64748B" />

                    <Entry
                        Placeholder="Ejemplo: V-20261115195231-4AE11A"
                        Text="{Binding FolioBuscado}"
                        TextColor="#0F172A"
                        PlaceholderColor="#64748B"
                        BackgroundColor="#F8FAFC"
                        HeightRequest="48"
                        FontSize="14" />

                    <HorizontalStackLayout Spacing="10">

                        <Button
                            Text="Buscar venta"
                            Command="{Binding ComandoBuscar}"
                            BackgroundColor="#2563EB"
                            TextColor="White" />

                        <Button
                            Text="Limpiar"
                            Command="{Binding ComandoLimpiar}"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155" />

                    </HorizontalStackLayout>

                    <ActivityIndicator
                        IsRunning="{Binding EstaOcupado}"
                        IsVisible="{Binding EstaOcupado}"
                        Color="#2563EB" />

                    <Label
                        Text="{Binding MensajeError}"
                        IsVisible="{Binding HayError}"
                        TextColor="#DC2626"
                        FontSize="13" />

                    <Label
                        Text="{Binding MensajeOk}"
                        IsVisible="{Binding HayOk}"
                        TextColor="#15803D"
                        FontSize="13" />

                </VerticalStackLayout>

            </Border>

            <!-- VENTA ENCONTRADA -->

            <VerticalStackLayout
                IsVisible="{Binding HayVenta}"
                Spacing="18">

                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Información de la venta"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Grid
                            ColumnDefinitions="110,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="8">

                            <Label
                                Text="Folio:"
                                FontAttributes="Bold"
                                TextColor="#475569" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding FolioVenta}"
                                TextColor="#0F172A" />

                            <Label
                                Grid.Row="1"
                                Text="Cliente:"
                                FontAttributes="Bold"
                                TextColor="#475569" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ClienteVenta}"
                                TextColor="#0F172A" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- PRODUCTOS -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Productos de la venta"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="Selecciona las unidades a devolver. Los productos quedarán en cuarentena."
                            FontSize="13"
                            TextColor="#64748B" />

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Productos}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:DetalleDevolucionVenta">

                                    <Border
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        Padding="14">

                                        <VerticalStackLayout Spacing="10">

                                            <Label
                                                Text="{Binding NombreProducto}"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="#0F172A" />

                                            <Label
                                                Text="{Binding NumeroLote, StringFormat='Lote: {0}'}"
                                                FontSize="12"
                                                TextColor="#64748B" />

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                RowDefinitions="Auto,Auto"
                                                ColumnSpacing="12"
                                                RowSpacing="8">

                                                <Label
                                                    Text="{Binding CantidadVendida, StringFormat='Vendidas: {0}'}"
                                                    FontSize="13"
                                                    TextColor="#475569" />

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding CantidadDisponible, StringFormat='Disponibles: {0}'}"
                                                    FontSize="13"
                                                    TextColor="#475569" />

                                                <Label
                                                    Grid.Row="1"
                                                    Text="Cantidad a devolver:"
                                                    FontSize="13"
                                                    VerticalTextAlignment="Center"
                                                    TextColor="#334155" />

                                                <Entry
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding CantidadDevolver, Mode=TwoWay}"
                                                    Keyboard="Numeric"
                                                    Placeholder="0"
                                                    TextColor="#0F172A"
                                                    PlaceholderColor="#64748B"
                                                    BackgroundColor="#F8FAFC"
                                                    HeightRequest="45"
                                                    FontSize="14"
                                                    TextChanged="OnCantidadTextChanged" />

                                            </Grid>

                                            <Label
                                                Text="Condición: CUARENTENA"
                                                FontSize="12"
                                                TextColor="#B45309" />

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- MOTIVO -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Motivo de la devolución"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Editor
                            Text="{Binding Motivo}"
                            Placeholder="Describe por qué el cliente devuelve los productos..."
                            TextColor="#0F172A"
                            PlaceholderColor="#64748B"
                            BackgroundColor="#F8FAFC"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            FontSize="14" />

                    </VerticalStackLayout>

                </Border>

                <!-- RESUMEN -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Resumen de devolución"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="{Binding ResumenTexto}"
                            FontSize="14"
                            TextColor="#475569" />

                        <Label
                            Text="{Binding TotalDevolucionTexto}"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />

                        <Label
                            Text="Monto preliminar. No constituye una nota de crédito tributaria."
                            FontSize="12"
                            TextColor="#64748B" />

                        <Button
                            Text="Registrar devolución"
                            Command="{Binding ComandoRegistrar}"
                            BackgroundColor="#16A34A"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="48" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
