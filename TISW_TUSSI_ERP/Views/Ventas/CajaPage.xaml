<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TISW_TUSSI_ERP.ViewModels.Ventas"
    xmlns:m="clr-namespace:TISW_TUSSI_ERP.Models.Ventas"
    xmlns:ctrl="clr-namespace:TISW_TUSSI_ERP.Views.Shared"
    x:Class="TISW_TUSSI_ERP.Views.Ventas.CajaPage"
    x:DataType="vm:CajaViewModel"
    Title="Control de Caja"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*">

        <ctrl:PageHeader
            Grid.Row="0"
            Ruta="ERP › Ventas"
            Titulo="Control de Caja" />

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- ENCABEZADO -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <VerticalStackLayout Spacing="3">
                        <Label
                            Text="Control y cierre de caja"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Administra movimientos, ventas y arqueo de efectivo."
                            FontSize="12"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Actualizar"
                        Command="{Binding ComandoActualizar}"
                        BackgroundColor="#E8F1FD"
                        TextColor="#1D6FD8"
                        CornerRadius="8"
                        Padding="14,8" />
                </Grid>

                <!-- MENSAJES -->
                <Border
                    BackgroundColor="#EFF6FF"
                    Stroke="#BFDBFE"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">

                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="12"
                        TextColor="#1D4ED8" />
                </Border>

                <!-- ESTADO GENERAL -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <Border
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 10"
                        Padding="14">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="CAJA"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Picker
                                Title="Seleccionar caja"
                                ItemsSource="{Binding Cajas}"
                                ItemDisplayBinding="{Binding NombreCaja}"
                                SelectedItem="{Binding CajaSeleccionada, Mode=TwoWay}"
                                TextColor="#172B4D"
                                BackgroundColor="#F8FAFC" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 10"
                        Padding="14">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="ESTADO DEL TURNO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Text="{Binding EstadoCaja}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 10"
                        Padding="14">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="EFECTIVO ESPERADO"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Text="{Binding SaldoEsperadoTexto}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- APERTURA -->
                <Border
                    IsVisible="{Binding NoHayTurnoAbierto}"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 10"
                    Padding="18">

                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Apertura de caja"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Ingresa el efectivo inicial para comenzar el turno."
                            FontSize="12"
                            TextColor="#64748B" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry
                                Text="{Binding MontoInicialTexto}"
                                Keyboard="Numeric"
                                Placeholder="Monto inicial"
                                TextColor="#172B4D"
                                BackgroundColor="#F8FAFC" />

                            <Button
                                Grid.Column="1"
                                Text="Abrir caja"
                                Clicked="OnAbrirClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"
                                Padding="24,10" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- RESUMEN DE VENTAS -->
                <Border
                    IsVisible="{Binding HayTurnoAbierto}"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 10"
                    Padding="18">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Resumen de ventas por forma de pago"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Ventas del período desde la apertura. Puede incluir otras cajas; no es una conciliación exclusiva de este turno."
                            FontSize="11"
                            TextColor="#64748B" />

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                            <Border
                                BackgroundColor="#F0FDF4"
                                Stroke="#BBF7D0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">

                                <VerticalStackLayout Spacing="7">
                                    <Label
                                        Text="EFECTIVO"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#166534" />

                                    <Label
                                        Text="{Binding EfectivoVentasTexto}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#166534" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">

                                <VerticalStackLayout Spacing="7">
                                    <Label
                                        Text="TARJETA"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#1D4ED8" />

                                    <Label
                                        Text="{Binding TarjetaTexto}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#1D4ED8" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Column="2"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">

                                <VerticalStackLayout Spacing="7">
                                    <Label
                                        Text="TRANSFERENCIA"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#475569" />

                                    <Label
                                        Text="{Binding TransferenciaTexto}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#172B4D" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Column="3"
                                BackgroundColor="#FFFBEB"
                                Stroke="#FDE68A"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">

                                <VerticalStackLayout Spacing="7">
                                    <Label
                                        Text="CRÉDITO"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#92400E" />

                                    <Label
                                        Text="{Binding CreditoTexto}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#92400E" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E2E8F0" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="TOTAL DE VENTAS"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Label
                                    Text="Incluye todas las formas de pago"
                                    FontSize="11"
                                    TextColor="#94A3B8" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="{Binding TotalVentasTexto}"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#2563EB"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Otros medios de pago"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding OtrosPagosTexto}"
                                FontSize="12"
                                TextColor="#475569" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- MOVIMIENTOS Y CIERRE -->
                <Grid
                    IsVisible="{Binding HayTurnoAbierto}"
                    ColumnDefinitions="1.15*,*"
                    ColumnSpacing="12">

                    <!-- MOVIMIENTOS -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 10"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="Movimientos del turno"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#172B4D" />

                            <Grid
                                ColumnDefinitions="*,100,110"
                                BackgroundColor="#F1F5F9"
                                Padding="8">

                                <Label
                                    Text="CONCEPTO"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Column="1"
                                    Text="TIPO"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Column="2"
                                    Text="MONTO"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B"
                                    HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView
                                ItemsSource="{Binding Movimientos}"
                                HeightRequest="340"
                                SelectionMode="None">

                                <CollectionView.EmptyView>
                                    <Label
                                        Text="Todavía no hay movimientos en este turno."
                                        FontSize="12"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center"
                                        Margin="0,20" />
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="m:MovimientoCaja">

                                        <Grid
                                            ColumnDefinitions="*,100,110"
                                            Padding="8,10"
                                            ColumnSpacing="5">

                                            <VerticalStackLayout Spacing="3">
                                                <Label
                                                    Text="{Binding Concepto}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#172B4D"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding FechaMovimiento, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                    FontSize="10"
                                                    TextColor="#94A3B8" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding TipoMovimiento}"
                                                FontSize="11"
                                                TextColor="#475569"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Monto, StringFormat='${0:N0}'}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#172B4D"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- PANEL DERECHO -->
                    <VerticalStackLayout Grid.Column="1" Spacing="12">

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 10"
                            Padding="16">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="Registrar movimiento"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D" />

                                <Label
                                    Text="Tipo de movimiento"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Picker
                                    ItemsSource="{Binding TiposMovimiento}"
                                    SelectedItem="{Binding TipoMovimiento, Mode=TwoWay}"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F8FAFC" />

                                <Label
                                    Text="Concepto"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Entry
                                    Text="{Binding Concepto}"
                                    Placeholder="Ej.: retiro para gastos"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F8FAFC" />

                                <Label
                                    Text="Monto"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Entry
                                    Text="{Binding MontoMovimientoTexto}"
                                    Keyboard="Numeric"
                                    Placeholder="Ej.: 10000"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F8FAFC" />

                                <Button
                                    Text="Registrar movimiento"
                                    Clicked="OnMovimientoClicked"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    CornerRadius="8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 10"
                            Padding="16">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="Cierre y arqueo"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#172B4D" />

                                <Label
                                    Text="Efectivo esperado"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Label
                                    Text="{Binding SaldoEsperadoTexto}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#2563EB" />

                                <Label
                                    Text="Efectivo contado"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Entry
                                    Text="{Binding MontoFinalTexto}"
                                    Keyboard="Numeric"
                                    Placeholder="Monto real contado"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F8FAFC" />

                                <Label
                                    Text="Observaciones"
                                    FontSize="11"
                                    TextColor="#64748B" />

                                <Editor
                                    Text="{Binding Observaciones}"
                                    Placeholder="Opcional: explica cualquier diferencia"
                                    HeightRequest="65"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F8FAFC" />

                                <Button
                                    Text="Cerrar caja"
                                    Clicked="OnCerrarClicked"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    CornerRadius="8" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
